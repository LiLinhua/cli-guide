[
  { "id": "mysql-connect", "cmd": "mysql", "cat": "mysql", "desc": "连接 MySQL 客户端",
    "syntax": "mysql -u <user> -p [-h <host>] [-P <port>] [db]",
    "args": [ { "name": "-u", "desc": "用户名" }, { "name": "-p", "desc": "密码(提示输入)" }, { "name": "-h", "desc": "主机" } ],
    "examples": [ { "cmd": "mysql -u root -p mydb", "comment": "连接本地 mydb 库" } ],
    "tags": ["mysql", "客户端"] },
  { "id": "mysql-exec", "cmd": "mysql -e", "cat": "mysql", "desc": "直接执行 SQL 语句",
    "syntax": "mysql -u <user> -p -e \"<sql>\"",
    "args": [],
    "examples": [ { "cmd": "mysql -u root -p -e 'SHOW DATABASES;'", "comment": "不进入交互直接查库列表" } ],
    "tags": ["mysql", "SQL"] },
  { "id": "mysql-run-file", "cmd": "mysql < file.sql", "cat": "mysql", "desc": "执行 SQL 脚本文件",
    "syntax": "mysql -u <user> -p <db> < file.sql",
    "args": [],
    "examples": [ { "cmd": "mysql -u root -p mydb < init.sql", "comment": "导入初始化脚本" } ],
    "tags": ["mysql", "导入"] },
  { "id": "mysqldump", "cmd": "mysqldump", "cat": "mysql", "desc": "逻辑备份数据库",
    "syntax": "mysqldump -u <user> -p [--single-transaction] <db> > backup.sql",
    "args": [ { "name": "--single-transaction", "desc": "InnoDB 一致性备份" }, { "name": "--all-databases", "desc": "备份全部库" } ],
    "examples": [ { "cmd": "mysqldump -u root -p --single-transaction mydb > mydb.sql", "comment": "在线备份 mydb" } ],
    "tags": ["mysql", "备份"] },
  { "id": "mysqladmin", "cmd": "mysqladmin", "cat": "mysql", "desc": "MySQL 管理工具",
    "syntax": "mysqladmin -u root -p <ping|status|processlist|shutdown>",
    "args": [ { "name": "ping", "desc": "检查存活" }, { "name": "status", "desc": "运行状态" }, { "name": "processlist", "desc": "当前连接" } ],
    "examples": [ { "cmd": "mysqladmin -u root -p status", "comment": "查看运行状态与 QPS" } ],
    "tags": ["mysql", "管理"] },
  { "id": "mysqlshow", "cmd": "mysqlshow", "cat": "mysql", "desc": "显示库/表信息",
    "syntax": "mysqlshow -u <user> -p [db [table]]",
    "args": [],
    "examples": [ { "cmd": "mysqlshow -u root -p mydb", "comment": "查看 mydb 的表列表" } ],
    "tags": ["mysql", "查看"] },
  { "id": "mysqlimport", "cmd": "mysqlimport", "cat": "mysql", "desc": "导入 CSV 文本文件",
    "syntax": "mysqlimport -u <user> -p --local <db> <file.csv>",
    "args": [ { "name": "--fields-terminated-by", "desc": "字段分隔符" }, { "name": "--ignore-lines 1", "desc": "跳过表头" } ],
    "examples": [ { "cmd": "mysqlimport -u root -p --local --ignore-lines 1 mydb data.csv", "comment": "导入带表头的 CSV" } ],
    "tags": ["mysql", "导入"] },
  { "id": "mysqlcheck", "cmd": "mysqlcheck", "cat": "mysql", "desc": "检查/修复表",
    "syntax": "mysqlcheck -u root -p <db> [--check|--repair|--analyze]",
    "args": [ { "name": "--repair", "desc": "修复损坏表" }, { "name": "--analyze", "desc": "更新统计信息" } ],
    "examples": [ { "cmd": "mysqlcheck -u root -p --repair mydb", "comment": "修复 mydb 所有表" } ],
    "tags": ["mysql", "维护"] },
  { "id": "mysql-config-editor", "cmd": "mysql_config_editor", "cat": "mysql", "desc": "安全保存登录凭证",
    "syntax": "mysql_config_editor set --login-path=<name> --host=<h> --user=<u> --password",
    "args": [ { "name": "--login-path", "desc": "凭证名" } ],
    "examples": [ { "cmd": "mysql_config_editor set --login-path=local --host=127.0.0.1 --user=root --password", "comment": "保存后可用 mysql --login-path=local 免密连接" } ],
    "tags": ["mysql", "安全"] },
  { "id": "mysql-show-databases", "cmd": "SHOW DATABASES", "cat": "mysql", "desc": "列出所有数据库",
    "syntax": "SHOW DATABASES;", "args": [],
    "examples": [ { "cmd": "SHOW DATABASES;", "comment": "查看全部库" } ],
    "tags": ["mysql", "SQL"] },
  { "id": "mysql-show-tables", "cmd": "SHOW TABLES", "cat": "mysql", "desc": "列出当前库的表",
    "syntax": "SHOW TABLES;", "args": [],
    "examples": [ { "cmd": "USE mydb; SHOW TABLES;", "comment": "查看 mydb 的表" } ],
    "tags": ["mysql", "SQL"] },
  { "id": "mysql-describe", "cmd": "DESCRIBE table", "cat": "mysql", "desc": "查看表结构",
    "syntax": "DESCRIBE <table>;",
    "args": [],
    "examples": [ { "cmd": "DESCRIBE users;", "comment": "查看 users 表字段定义" } ],
    "tags": ["mysql", "SQL"] },
  { "id": "mysql-processlist", "cmd": "SHOW PROCESSLIST", "cat": "mysql", "desc": "查看当前连接与查询",
    "syntax": "SHOW PROCESSLIST;",
    "args": [ { "name": "FULL", "desc": "显示完整 SQL" } ],
    "examples": [ { "cmd": "SHOW FULL PROCESSLIST;", "comment": "定位慢查询/锁" } ],
    "tags": ["mysql", "监控"] },
  { "id": "mysql-variables", "cmd": "SHOW VARIABLES", "cat": "mysql", "desc": "查看系统变量",
    "syntax": "SHOW VARIABLES LIKE '<pattern>';",
    "args": [],
    "examples": [ { "cmd": "SHOW VARIABLES LIKE 'max_connections';", "comment": "查看最大连接数" } ],
    "tags": ["mysql", "配置"] },
  { "id": "mysql-create-database", "cmd": "CREATE DATABASE", "cat": "mysql", "desc": "创建数据库",
    "syntax": "CREATE DATABASE <db> DEFAULT CHARACTER SET utf8mb4;",
    "args": [],
    "examples": [ { "cmd": "CREATE DATABASE app DEFAULT CHARACTER SET utf8mb4;", "comment": "建库并指定 utf8mb4" } ],
    "tags": ["mysql", "DDL"] },
  { "id": "mysql-drop-database", "cmd": "DROP DATABASE", "cat": "mysql", "desc": "删除数据库",
    "syntax": "DROP DATABASE <db>;", "args": [],
    "examples": [ { "cmd": "DROP DATABASE old_app;", "comment": "删除旧库(慎用)" } ],
    "tags": ["mysql", "DDL"] },
  { "id": "mysql-grant", "cmd": "GRANT", "cat": "mysql", "desc": "授权用户权限",
    "syntax": "GRANT ALL PRIVILEGES ON <db>.* TO '<user>'@'<host>';",
    "args": [],
    "examples": [ { "cmd": "GRANT SELECT, INSERT ON app.* TO 'dev'@'%';", "comment": "只给 dev 读写权限" } ],
    "tags": ["mysql", "权限"] },
  { "id": "mysql-flush-privileges", "cmd": "FLUSH PRIVILEGES", "cat": "mysql", "desc": "刷新权限表",
    "syntax": "FLUSH PRIVILEGES;", "args": [],
    "examples": [ { "cmd": "FLUSH PRIVILEGES;", "comment": "直接改权限表后生效" } ],
    "tags": ["mysql", "权限"] },
  { "id": "mysql-set-global", "cmd": "SET GLOBAL", "cat": "mysql", "desc": "修改全局变量(运行时)",
    "syntax": "SET GLOBAL <var> = <value>;",
    "args": [],
    "examples": [ { "cmd": "SET GLOBAL max_connections = 500;", "comment": "临时调大连接数" } ],
    "tags": ["mysql", "配置"] },
  { "id": "mysql-explain", "cmd": "EXPLAIN", "cat": "mysql", "desc": "查看 SQL 执行计划",
    "syntax": "EXPLAIN <select-sql>;",
    "args": [],
    "examples": [ { "cmd": "EXPLAIN SELECT * FROM orders WHERE user_id=1;", "comment": "检查是否走索引" } ],
    "tags": ["mysql", "优化"] },
  { "id": "mysql-select-limit", "cmd": "SELECT ... LIMIT", "cat": "mysql", "desc": "分页查询",
    "syntax": "SELECT <cols> FROM <table> LIMIT <offset>, <count>;",
    "args": [],
    "examples": [ { "cmd": "SELECT * FROM orders ORDER BY id DESC LIMIT 0, 20;", "comment": "第一页 20 条" } ],
    "tags": ["mysql", "SQL"] },
  { "id": "mysql-alter-table", "cmd": "ALTER TABLE", "cat": "mysql", "desc": "修改表结构",
    "syntax": "ALTER TABLE <table> ADD COLUMN <col> <type>;",
    "args": [ { "name": "ADD COLUMN", "desc": "加列" }, { "name": "DROP COLUMN", "desc": "删列" }, { "name": "ADD INDEX", "desc": "加索引" } ],
    "examples": [ { "cmd": "ALTER TABLE users ADD INDEX idx_email (email);", "comment": "为 email 加索引" } ],
    "tags": ["mysql", "DDL"] },
  { "id": "mysql-show-status", "cmd": "SHOW STATUS", "cat": "mysql", "desc": "查看运行状态变量",
    "syntax": "SHOW STATUS LIKE '<pattern>'", "args": [],
    "examples": [ { "cmd": "SHOW STATUS LIKE 'Threads_connected'", "comment": "查看当前连接数" } ],
    "tags": ["mysql", "监控"] },
  { "id": "mysql-show-index", "cmd": "SHOW INDEX FROM", "cat": "mysql", "desc": "查看表索引",
    "syntax": "SHOW INDEX FROM <table>", "args": [],
    "examples": [ { "cmd": "SHOW INDEX FROM orders", "comment": "检查索引是否生效" } ],
    "tags": ["mysql", "优化"] },
  { "id": "mysql-use", "cmd": "USE db", "cat": "mysql", "desc": "切换数据库",
    "syntax": "USE <db>;", "args": [],
    "examples": [ { "cmd": "USE mydb;", "comment": "切换到 mydb 库" } ],
    "tags": ["mysql", "SQL"] }
]
