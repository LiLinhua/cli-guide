[
  { "id": "mysql-connect", "cmd": "mysql", "cat": "mysql", "desc": "连接 MySQL 客户端",
    "syntax": "mysql -u <user> -p [-h <host>] [-P <port>] [db]",
    "args": [],
    "examples": [
      { "cmd": "mysql -u root -p", "comment": "本地连接 root" },
      { "cmd": "mysql -u app -p -h 10.0.0.5 appdb", "comment": "远程连接指定库" },
      { "cmd": "mysql -u root -p -h 127.0.0.1 -P 3307", "comment": "指定端口连接" },
      { "cmd": "mysql -u root -p --default-character-set=utf8mb4 appdb", "comment": "指定字符集连接" },
      { "cmd": "mysql -u root -p < /dev/null", "comment": "非交互测试连接" }
    ],
    "tags": ["mysql", "连接"] },
  { "id": "mysql-exec", "cmd": "mysql -e", "cat": "mysql", "desc": "直接执行 SQL 语句",
    "syntax": "mysql -u <user> -p -e \"<sql>\"",
    "args": [],
    "examples": [
      { "cmd": "mysql -u root -p -e 'SELECT VERSION();'", "comment": "查版本" },
      { "cmd": "mysql -u root -p -e 'SHOW DATABASES;'", "comment": "列出数据库" },
      { "cmd": "mysql -u root -p appdb -e 'SELECT COUNT(*) FROM users;'", "comment": "统计行数" },
      { "cmd": "mysql -u root -p -e 'SET GLOBAL max_connections=500;'", "comment": "动态改全局变量" },
      { "cmd": "mysql -u root -p appdb -e 'DELETE FROM logs WHERE created_at < NOW() - INTERVAL 7 DAY;'", "comment": "清理过期数据" }
    ],
    "tags": ["mysql", "执行"] },
  { "id": "mysql-run-file", "cmd": "mysql < file.sql", "cat": "mysql", "desc": "执行 SQL 脚本文件",
    "syntax": "mysql -u <user> -p <db> < file.sql",
    "args": [],
    "examples": [
      { "cmd": "mysql -u root -p appdb < init.sql", "comment": "执行初始化脚本" },
      { "cmd": "mysql -u root -p appdb < backup.sql", "comment": "导入备份" },
      { "cmd": "mysql -u root -p < migrations/001_create_users.sql", "comment": "执行迁移文件" },
      { "cmd": "mysql -u root -p appdb --force < data.sql", "comment": "忽略错误继续执行" }
    ],
    "tags": ["mysql", "脚本"] },
  { "id": "mysqldump", "cmd": "mysqldump", "cat": "mysql", "desc": "逻辑备份数据库",
    "syntax": "mysqldump -u <user> -p [--single-transaction] <db> > backup.sql",
    "args": [],
    "examples": [
      { "cmd": "mysqldump -u root -p appdb > backup.sql", "comment": "备份整个库" },
      { "cmd": "mysqldump -u root -p --single-transaction appdb > backup.sql", "comment": "InnoDB 一致性备份" },
      { "cmd": "mysqldump -u root -p appdb users orders > tables.sql", "comment": "只备份指定表" },
      { "cmd": "mysqldump -u root -p --no-data appdb > schema.sql", "comment": "只备份表结构" },
      { "cmd": "mysqldump -u root -p --all-databases > all.sql", "comment": "备份全部数据库" },
      { "cmd": "mysqldump -u root -p appdb | gzip > backup.sql.gz", "comment": "压缩备份" },
      { "cmd": "mysqldump -u root -p --where=\"created_at > '2026-01-01'\" appdb orders > partial.sql", "comment": "条件备份" }
    ],
    "tags": ["mysql", "备份"] },
  { "id": "mysqladmin", "cmd": "mysqladmin", "cat": "mysql", "desc": "MySQL 管理工具",
    "syntax": "mysqladmin -u root -p <ping|status|processlist|shutdown>",
    "args": [],
    "examples": [
      { "cmd": "mysqladmin -u root -p ping", "comment": "探测服务存活" },
      { "cmd": "mysqladmin -u root -p status", "comment": "查看运行状态" },
      { "cmd": "mysqladmin -u root -p processlist", "comment": "查看当前连接" },
      { "cmd": "mysqladmin -u root -p shutdown", "comment": "优雅关闭服务" },
      { "cmd": "mysqladmin -u root -p create newdb", "comment": "命令行建库" }
    ],
    "tags": ["mysql", "管理"] },
  { "id": "mysqlshow", "cmd": "mysqlshow", "cat": "mysql", "desc": "显示库/表信息",
    "syntax": "mysqlshow -u <user> -p [db [table]]",
    "args": [],
    "examples": [
      { "cmd": "mysqlshow -u root -p", "comment": "列出全部数据库" },
      { "cmd": "mysqlshow -u root -p appdb", "comment": "列出库的表" },
      { "cmd": "mysqlshow -u root -p appdb users", "comment": "查看表结构" },
      { "cmd": "mysqlshow -u root -p appdb -i users", "comment": "查看表详细信息" }
    ],
    "tags": ["mysql", "查看"] },
  { "id": "mysqlimport", "cmd": "mysqlimport", "cat": "mysql", "desc": "导入 CSV 文本文件",
    "syntax": "mysqlimport -u <user> -p --local <db> <file.csv>",
    "args": [],
    "examples": [
      { "cmd": "mysqlimport -u root -p --local appdb users.csv", "comment": "导入 CSV(表名=文件名)" },
      { "cmd": "mysqlimport -u root -p --local --ignore-lines=1 appdb users.csv", "comment": "跳过表头导入" },
      { "cmd": "mysqlimport -u root -p --local --fields-terminated-by=',' appdb data.csv", "comment": "指定分隔符" },
      { "cmd": "mysqlimport -u root -p --local --replace appdb users.csv", "comment": "冲突时替换" }
    ],
    "tags": ["mysql", "导入"] },
  { "id": "mysqlcheck", "cmd": "mysqlcheck", "cat": "mysql", "desc": "检查/修复表",
    "syntax": "mysqlcheck -u root -p <db> [--check|--repair|--analyze]",
    "args": [],
    "examples": [
      { "cmd": "mysqlcheck -u root -p appdb", "comment": "检查库中所有表" },
      { "cmd": "mysqlcheck -u root -p --check appdb users", "comment": "检查指定表" },
      { "cmd": "mysqlcheck -u root -p --repair appdb", "comment": "修复损坏表" },
      { "cmd": "mysqlcheck -u root -p --analyze appdb", "comment": "分析并更新统计信息" },
      { "cmd": "mysqlcheck -u root -p --optimize appdb", "comment": "优化表碎片" }
    ],
    "tags": ["mysql", "维护"] },
  { "id": "mysql-config-editor", "cmd": "mysql_config_editor", "cat": "mysql", "desc": "安全保存登录凭证",
    "syntax": "mysql_config_editor set --login-path=<name> --host=<h> --user=<u> --password",
    "args": [],
    "examples": [
      { "cmd": "mysql_config_editor set --login-path=local --host=127.0.0.1 --user=root --password", "comment": "保存本机凭证" },
      { "cmd": "mysql --login-path=local", "comment": "免密登录" },
      { "cmd": "mysql_config_editor print --all", "comment": "查看已保存凭证" },
      { "cmd": "mysql_config_editor remove --login-path=local", "comment": "删除凭证" }
    ],
    "tags": ["mysql", "安全"] },
  { "id": "mysql-show-databases", "cmd": "SHOW DATABASES;", "cat": "mysql", "desc": "列出所有数据库",
    "syntax": "SHOW DATABASES;",
    "args": [],
    "examples": [
      { "cmd": "SHOW DATABASES;", "comment": "列出全部数据库" },
      { "cmd": "SHOW DATABASES LIKE 'app%';", "comment": "按模式过滤" },
      { "cmd": "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA;", "comment": "用元数据查询" }
    ],
    "tags": ["mysql", "查询"] },
  { "id": "mysql-show-tables", "cmd": "SHOW TABLES;", "cat": "mysql", "desc": "列出当前库的表",
    "syntax": "SHOW TABLES;",
    "args": [],
    "examples": [
      { "cmd": "USE appdb; SHOW TABLES;", "comment": "先切库再列表" },
      { "cmd": "SHOW TABLES LIKE 'user%';", "comment": "按前缀过滤" },
      { "cmd": "SHOW FULL TABLES;", "comment": "含视图信息" },
      { "cmd": "SHOW TABLES FROM appdb;", "comment": "不切库直接看" }
    ],
    "tags": ["mysql", "查询"] },
  { "id": "mysql-describe", "cmd": "DESCRIBE <table>;", "cat": "mysql", "desc": "查看表结构",
    "syntax": "DESCRIBE <table>;",
    "args": [],
    "examples": [
      { "cmd": "DESCRIBE users;", "comment": "查看表字段" },
      { "cmd": "SHOW CREATE TABLE users;", "comment": "查看建表语句" },
      { "cmd": "SHOW COLUMNS FROM users;", "comment": "等价于 DESCRIBE" },
      { "cmd": "DESC users;", "comment": "缩写形式" }
    ],
    "tags": ["mysql", "结构"] },
  { "id": "mysql-processlist", "cmd": "SHOW PROCESSLIST;", "cat": "mysql", "desc": "查看当前连接与查询",
    "syntax": "SHOW PROCESSLIST;",
    "args": [],
    "examples": [
      { "cmd": "SHOW PROCESSLIST;", "comment": "查看当前全部连接" },
      { "cmd": "SHOW FULL PROCESSLIST;", "comment": "含完整 SQL 文本" },
      { "cmd": "SHOW PROCESSLIST; | grep -i sleep", "comment": "找空闲连接" },
      { "cmd": "KILL 12345;", "comment": "终止慢查询连接" }
    ],
    "tags": ["mysql", "监控"] },
  { "id": "mysql-variables", "cmd": "SHOW VARIABLES;", "cat": "mysql", "desc": "查看系统变量",
    "syntax": "SHOW VARIABLES LIKE '<pattern>';",
    "args": [],
    "examples": [
      { "cmd": "SHOW VARIABLES LIKE 'max_connections';", "comment": "最大连接数" },
      { "cmd": "SHOW VARIABLES LIKE '%timeout%';", "comment": "全部超时配置" },
      { "cmd": "SHOW VARIABLES LIKE 'character_set%';", "comment": "字符集配置" },
      { "cmd": "SHOW VARIABLES LIKE 'innodb_buffer%';", "comment": "InnoDB 缓冲池" }
    ],
    "tags": ["mysql", "配置"] },
  { "id": "mysql-create-database", "cmd": "CREATE DATABASE;", "cat": "mysql", "desc": "创建数据库",
    "syntax": "CREATE DATABASE <db> DEFAULT CHARACTER SET utf8mb4;",
    "args": [],
    "examples": [
      { "cmd": "CREATE DATABASE appdb DEFAULT CHARACTER SET utf8mb4;", "comment": "标准创建(支持 emoji)" },
      { "cmd": "CREATE DATABASE IF NOT EXISTS appdb;", "comment": "存在则跳过" },
      { "cmd": "CREATE DATABASE testdb CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;", "comment": "指定排序规则" },
      { "cmd": "SHOW CREATE DATABASE appdb;", "comment": "确认创建结果" }
    ],
    "tags": ["mysql", "DDL"] },
  { "id": "mysql-drop-database", "cmd": "DROP DATABASE;", "cat": "mysql", "desc": "删除数据库",
    "syntax": "DROP DATABASE <db>;",
    "args": [],
    "examples": [
      { "cmd": "DROP DATABASE olddb;", "comment": "删除库(慎用)" },
      { "cmd": "DROP DATABASE IF EXISTS tmpdb;", "comment": "存在才删" },
      { "cmd": "DROP DATABASE appdb;", "comment": "删除前先备份" }
    ],
    "tags": ["mysql", "DDL"] },
  { "id": "mysql-grant", "cmd": "GRANT;", "cat": "mysql", "desc": "授权用户权限",
    "syntax": "GRANT ALL PRIVILEGES ON <db>.* TO '<user>'@'<host>';",
    "args": [],
    "examples": [
      { "cmd": "GRANT ALL PRIVILEGES ON appdb.* TO 'app'@'localhost';", "comment": "本地全权限" },
      { "cmd": "GRANT SELECT, INSERT, UPDATE ON appdb.* TO 'reader'@'%';", "comment": "只读+写入权限" },
      { "cmd": "GRANT SELECT ON appdb.* TO 'report'@'10.0.0.%';", "comment": "网段只读权限" },
      { "cmd": "CREATE USER 'app'@'localhost' IDENTIFIED BY 'secret';", "comment": "先建用户再授权" },
      { "cmd": "REVOKE DROP ON appdb.* FROM 'app'@'localhost';", "comment": "回收删除权限" },
      { "cmd": "FLUSH PRIVILEGES;", "comment": "刷新生效" }
    ],
    "tags": ["mysql", "权限"] },
  { "id": "mysql-flush-privileges", "cmd": "FLUSH PRIVILEGES;", "cat": "mysql", "desc": "刷新权限表",
    "syntax": "FLUSH PRIVILEGES;",
    "args": [],
    "examples": [
      { "cmd": "FLUSH PRIVILEGES;", "comment": "授权后刷新生效" },
      { "cmd": "GRANT ...; FLUSH PRIVILEGES;", "comment": "授权并刷新" },
      { "cmd": "FLUSH TABLES;", "comment": "关闭并重开所有表" }
    ],
    "tags": ["mysql", "权限"] },
  { "id": "mysql-set-global", "cmd": "SET GLOBAL;", "cat": "mysql", "desc": "修改全局变量(运行时)",
    "syntax": "SET GLOBAL <var> = <value>;",
    "args": [],
    "examples": [
      { "cmd": "SET GLOBAL max_connections = 500;", "comment": "调大连接数" },
      { "cmd": "SET GLOBAL sql_mode = 'STRICT_TRANS_TABLES';", "comment": "设置 SQL 模式" },
      { "cmd": "SET GLOBAL slow_query_log = ON;", "comment": "开启慢查询日志" },
      { "cmd": "SET GLOBAL long_query_time = 2;", "comment": "慢查询阈值 2 秒" },
      { "cmd": "SET SESSION sql_mode = '';", "comment": "当前会话临时设置" }
    ],
    "tags": ["mysql", "配置"] },
  { "id": "mysql-explain", "cmd": "EXPLAIN;", "cat": "mysql", "desc": "查看 SQL 执行计划",
    "syntax": "EXPLAIN <select-sql>;",
    "args": [],
    "examples": [
      { "cmd": "EXPLAIN SELECT * FROM users WHERE email='a@b.com';", "comment": "查看执行计划" },
      { "cmd": "EXPLAIN ANALYZE SELECT * FROM orders WHERE user_id=1;", "comment": "真实执行并分析" },
      { "cmd": "EXPLAIN SELECT * FROM orders JOIN users ON orders.user_id=users.id;", "comment": "联表计划" },
      { "cmd": "EXPLAIN FORMAT=JSON SELECT * FROM users WHERE id=1;", "comment": "JSON 格式计划" },
      { "cmd": "EXPLAIN SELECT ...; 看 type 列", "comment": "ALL=全表扫描需加索引" }
    ],
    "tags": ["mysql", "优化"] },
  { "id": "mysql-select-limit", "cmd": "SELECT ... LIMIT;", "cat": "mysql", "desc": "分页查询",
    "syntax": "SELECT <cols> FROM <table> LIMIT <offset>, <count>;",
    "args": [],
    "examples": [
      { "cmd": "SELECT * FROM users LIMIT 10;", "comment": "取前 10 条" },
      { "cmd": "SELECT * FROM users LIMIT 20, 10;", "comment": "第 21-30 条(分页)" },
      { "cmd": "SELECT * FROM orders ORDER BY created_at DESC LIMIT 5;", "comment": "最新 5 条订单" },
      { "cmd": "SELECT id, name FROM users WHERE status=1 LIMIT 50;", "comment": "条件分页" }
    ],
    "tags": ["mysql", "查询"] },
  { "id": "mysql-alter-table", "cmd": "ALTER TABLE;", "cat": "mysql", "desc": "修改表结构",
    "syntax": "ALTER TABLE <table> ADD COLUMN <col> <type>;",
    "args": [],
    "examples": [
      { "cmd": "ALTER TABLE users ADD COLUMN phone VARCHAR(20);", "comment": "加字段" },
      { "cmd": "ALTER TABLE users DROP COLUMN old_col;", "comment": "删字段" },
      { "cmd": "ALTER TABLE users MODIFY COLUMN name VARCHAR(64);", "comment": "改字段类型" },
      { "cmd": "ALTER TABLE users ADD INDEX idx_email (email);", "comment": "加索引" },
      { "cmd": "ALTER TABLE users RENAME TO members;", "comment": "表改名" }
    ],
    "tags": ["mysql", "DDL"] },
  { "id": "mysql-show-status", "cmd": "SHOW STATUS;", "cat": "mysql", "desc": "查看运行状态变量",
    "syntax": "SHOW STATUS LIKE '<pattern>'",
    "args": [],
    "examples": [
      { "cmd": "SHOW STATUS LIKE 'Threads_connected';", "comment": "当前连接数" },
      { "cmd": "SHOW STATUS LIKE 'QPS';", "comment": "每秒查询数" },
      { "cmd": "SHOW STATUS LIKE 'Slow_queries';", "comment": "慢查询数" },
      { "cmd": "SHOW STATUS LIKE 'Innodb_buffer_pool_read%';", "comment": "缓冲池命中情况" }
    ],
    "tags": ["mysql", "监控"] },
  { "id": "mysql-show-index", "cmd": "SHOW INDEX;", "cat": "mysql", "desc": "查看表索引",
    "syntax": "SHOW INDEX FROM <table>",
    "args": [],
    "examples": [
      { "cmd": "SHOW INDEX FROM users;", "comment": "查看表全部索引" },
      { "cmd": "SHOW INDEX FROM users WHERE Key_name='idx_email';", "comment": "查看指定索引" },
      { "cmd": "SHOW INDEX FROM orders; 看 Cardinality", "comment": "评估索引区分度" }
    ],
    "tags": ["mysql", "索引"] },
  { "id": "mysql-use", "cmd": "USE <db>;", "cat": "mysql", "desc": "切换数据库",
    "syntax": "USE <db>;",
    "args": [],
    "examples": [
      { "cmd": "USE appdb;", "comment": "切换数据库" },
      { "cmd": "mysql -u root -p appdb", "comment": "连接时直接指定库" },
      { "cmd": "SELECT DATABASE();", "comment": "查看当前库" }
    ],
    "tags": ["mysql", "数据库"] }
]
