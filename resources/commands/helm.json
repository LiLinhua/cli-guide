      { "cmd": "helm get values my-app -o yaml > current.yaml", "comment": "导出当前配置" },
      { "cmd": "helm get values my-app --revision 2", "comment": "查看历史版本配置" }
    ],
    "tags": ["配置"] },
  { "id": "helm-history", "cmd": "helm history", "cat": "helm", "desc": "查看发布历史",
