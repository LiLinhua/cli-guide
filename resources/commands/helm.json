      { "cmd": "helm pull bitnami/redis --version 17.0.0", "comment": "下载指定版本" },
      { "cmd": "helm pull myrepo/app --untar --untardir ./charts", "comment": "解压到指定目录" },
      { "cmd": "helm pull bitnami/nginx --verify", "comment": "下载并校验签名" }
    ],
    "tags": ["下载"] },
  { "id": "helm-package", "cmd": "helm package", "cat": "helm", "desc": "打包 chart",
