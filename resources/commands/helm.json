  { "id": "helm-pull", "cmd": "helm pull", "cat": "helm", "desc": "下载 chart",
    "syntax": "helm pull <chart> [--untar]",
    "args": [ { "name": "--untar", "desc": "解压到目录" } ],
    "examples": [
      { "cmd": "helm pull bitnami/redis", "comment": "下载 chart 包" },
