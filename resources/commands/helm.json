[
  { "id": "helm-install", "cmd": "helm install", "cat": "helm", "desc": "安装 chart",
    "syntax": "helm install <name> <chart> [-n <ns>] [--values f.yaml]",
    "args": [ { "name": "--values/-f", "desc": "指定 values 文件" }, { "name": "--set", "desc": "覆盖参数" }, { "name": "-n", "desc": "命名空间" } ],
    "examples": [
      { "cmd": "helm install my-nginx nginx", "comment": "安装 chart 到当前命名空间" },
      { "cmd": "helm install my-nginx nginx -n prod", "comment": "安装到指定命名空间" },
      { "cmd": "helm install my-app ./app --values prod-values.yaml", "comment": "用 values 文件安装" },
      { "cmd": "helm install my-app ./app --set replicaCount=3 --set image.tag=v2", "comment": "--set 覆盖参数" },
      { "cmd": "helm install my-nginx nginx --create-namespace -n staging", "comment": "创建命名空间并安装" },
      { "cmd": "helm install my-app ./app --atomic", "comment": "失败自动回滚安装" }
    ],
    "tags": ["安装"] },
  { "id": "helm-upgrade", "cmd": "helm upgrade", "cat": "helm", "desc": "升级 release",
    "syntax": "helm upgrade <release> <chart> [--values f.yaml]",
    "args": [ { "name": "--values/-f", "desc": "新配置" }, { "name": "--set", "desc": "覆盖参数" } ],
    "examples": [
      { "cmd": "helm upgrade my-nginx nginx", "comment": "升级到 chart 新版本" },
      { "cmd": "helm upgrade my-app ./app --values prod-values.yaml", "comment": "带配置升级" },
      { "cmd": "helm upgrade my-app ./app --set image.tag=v3", "comment": "只改镜像版本" },
      { "cmd": "helm upgrade my-nginx nginx --version 4.0.0", "comment": "升级到指定 chart 版本" },
      { "cmd": "helm upgrade my-app ./app --atomic", "comment": "升级失败自动回滚" },
      { "cmd": "helm upgrade my-app ./app --force", "comment": "强制替换重建" }
    ],
    "tags": ["升级"] },
  { "id": "helm-rollback", "cmd": "helm rollback", "cat": "helm", "desc": "回滚 release",
    "syntax": "helm rollback <release> <revision>",
    "args": [ { "name": "revision", "desc": "目标版本号" } ],
    "examples": [
      { "cmd": "helm rollback my-app 3", "comment": "回滚到第 3 版" },
      { "cmd": "helm rollback my-app 1 --wait", "comment": "回滚并等待就绪" },
      { "cmd": "helm history my-app", "comment": "先查看版本号" },
      { "cmd": "helm rollback my-app 2 --force", "comment": "强制回滚" }
    ],
    "tags": ["回滚"] },
  { "id": "helm-uninstall", "cmd": "helm uninstall", "cat": "helm", "desc": "卸载 release",
    "syntax": "helm uninstall <release> [-n <ns>]",
    "args": [ { "name": "-n", "desc": "命名空间" } ],
    "examples": [
      { "cmd": "helm uninstall my-nginx", "comment": "卸载 release" },
      { "cmd": "helm uninstall my-app -n prod", "comment": "卸载指定命名空间" },
      { "cmd": "helm uninstall my-app --keep-history", "comment": "卸载但保留历史" },
      { "cmd": "helm uninstall my-app --wait", "comment": "等待资源清理完成" },
      { "cmd": "helm ls --all", "comment": "确认已卸载" }
    ],
    "tags": ["卸载"] },
  { "id": "helm-list", "cmd": "helm list", "cat": "helm", "desc": "列出 release",
    "syntax": "helm list [-A] [-n <ns>]",
    "args": [ { "name": "-A", "desc": "所有命名空间" } ],
    "examples": [
      { "cmd": "helm list", "comment": "列出当前命名空间 release" },
      { "cmd": "helm list -A", "comment": "列出全部命名空间 release" },
      { "cmd": "helm list -n prod", "comment": "指定命名空间查看" },
      { "cmd": "helm list --all", "comment": "含已卸载的 release" },
      { "cmd": "helm list -f 'my.*'", "comment": "按名字过滤" },
      { "cmd": "helm ls --short", "comment": "只输出 release 名" }
    ],
    "tags": ["列表"] },
  { "id": "helm-status", "cmd": "helm status", "cat": "helm", "desc": "查看 release 状态",
    "syntax": "helm status <release>",
    "args": [],
    "examples": [
      { "cmd": "helm status my-nginx", "comment": "查看 release 状态" },
      { "cmd": "helm status my-app --show-resources", "comment": "连带资源清单一起看" },
      { "cmd": "helm status my-app -n prod", "comment": "指定命名空间查看" },
      { "cmd": "helm status my-nginx --revision 3", "comment": "查看历史版本状态" }
    ],
    "tags": ["状态"] },
  { "id": "helm-repo-add", "cmd": "helm repo add", "cat": "helm", "desc": "添加仓库",
