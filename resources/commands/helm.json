      { "cmd": "helm repo add bitnami https://charts.bitnami.com/bitnami", "comment": "添加 Bitnami 仓库" },
      { "cmd": "helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx", "comment": "添加 ingress-nginx 仓库" },
      { "cmd": "helm repo add myrepo https://repo.example.com/charts", "comment": "添加私有仓库" },
      { "cmd": "helm repo add stable https://charts.helm.sh/stable", "comment": "添加官方稳定仓库" },
      { "cmd": "helm repo update", "comment": "添加后更新索引" }
    ],
    "tags": ["仓库"] },
  { "id": "helm-repo-update", "cmd": "helm repo update", "cat": "helm", "desc": "更新仓库索引",
    "syntax": "helm repo update",
    "args": [],
    "examples": [
      { "cmd": "helm repo update", "comment": "更新全部仓库索引" },
      { "cmd": "helm repo update bitnami", "comment": "只更新指定仓库" },
      { "cmd": "helm search repo nginx", "comment": "更新后搜索新版本" },
      { "cmd": "helm repo update --fail-on-repo-update-fail", "comment": "更新失败即报错" }
    ],
    "tags": ["仓库"] },
  { "id": "helm-search", "cmd": "helm search", "cat": "helm", "desc": "搜索 chart",
    "syntax": "helm search repo <keyword>",
    "args": [],
    "examples": [
      { "cmd": "helm search repo nginx", "comment": "搜索 nginx chart" },
      { "cmd": "helm search repo mysql --versions", "comment": "查看全部版本" },
      { "cmd": "helm search repo redis --max-col-width 0", "comment": "完整信息搜索" },
      { "cmd": "helm search repo 'postgres' -l", "comment": "只看最新版本" },
      { "cmd": "helm search hub prometheus", "comment": "搜索 Helm Hub" }
    ],
    "tags": ["搜索"] },
  { "id": "helm-create", "cmd": "helm create", "cat": "helm", "desc": "创建 chart 骨架",
    "syntax": "helm create <name>",
    "args": [],
    "examples": [
      { "cmd": "helm create mychart", "comment": "创建标准 chart 骨架" },
      { "cmd": "helm create mychart && tree mychart", "comment": "创建并查看结构" },
      { "cmd": "helm create --starter my-starter mychart", "comment": "用自定义 starter 创建" },
      { "cmd": "cd mychart && helm lint .", "comment": "创建后检查规范" }
    ],
    "tags": ["创建"] },
  { "id": "helm-template", "cmd": "helm template", "cat": "helm", "desc": "本地渲染模板(不部署)",
    "syntax": "helm template <name> <chart>",
    "args": [ { "name": "-f", "desc": "values 文件" } ],
    "examples": [
      { "cmd": "helm template my-app ./app", "comment": "本地渲染清单" },
      { "cmd": "helm template my-app ./app -f prod.yaml", "comment": "按配置渲染" },
      { "cmd": "helm template my-app ./app --set replicaCount=2", "comment": "带参数渲染" },
      { "cmd": "helm template my-app ./app --debug", "comment": "渲染含调试信息" },
      { "cmd": "helm template my-app ./app | kubectl apply --dry-run=client -f -", "comment": "渲染后试运行" },
      { "cmd": "helm template my-app ./app --output-dir rendered/", "comment": "渲染输出到目录" }
    ],
    "tags": ["渲染", "调试"] },
  { "id": "helm-lint", "cmd": "helm lint", "cat": "helm", "desc": "检查 chart 规范",
    "syntax": "helm lint <chart>",
    "args": [],
    "examples": [
      { "cmd": "helm lint ./mychart", "comment": "检查 chart 规范" },
      { "cmd": "helm lint ./mychart -f values.yaml", "comment": "带配置检查" },
      { "cmd": "helm lint ./mychart --strict", "comment": "严格模式检查" },
      { "cmd": "helm lint ./mychart --set replicas=2", "comment": "带参数检查" },
      { "cmd": "helm lint ./mychart | tail -5", "comment": "只看检查结论" }
    ],
    "tags": ["检查"] },
  { "id": "helm-get-values", "cmd": "helm get values", "cat": "helm", "desc": "查看 release 配置",
