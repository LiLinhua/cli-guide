      { "cmd": "helm push app-2.0.0.tgz oci://registry.example.com/charts", "comment": "推送到 OCI 仓库" },
      { "cmd": "helm package ./app && helm push app-*.tgz myrepo", "comment": "打包后推送" }
    ],
    "tags": ["发布"] },
