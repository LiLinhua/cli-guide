{
  "cat": "linux",
  "label": "linux 命令",
  "order": 1,
  "commands": [
    {
      "id": "ls",
      "cmd": "ls",
      "cat": "linux",
      "desc": "列出目录内容",
      "syntax": "ls [-l] [-a] [-h] [path]",
      "args": [
        {
          "name": "-l",
          "desc": "长格式(权限/大小/时间)"
        },
        {
          "name": "-a",
          "desc": "包含隐藏文件"
        },
        {
          "name": "-h",
          "desc": "人类可读大小"
        }
      ],
      "examples": [
        {
          "cmd": "ls",
          "comment": "列出当前目录"
        },
        {
          "cmd": "ls -l",
          "comment": "长格式看权限/属主/大小"
        },
        {
          "cmd": "ls -a",
          "comment": "包含 . 开头的隐藏文件"
        },
        {
          "cmd": "ls -lah /var/log",
          "comment": "查看日志目录全部文件详情"
        },
        {
          "cmd": "ls -lS",
          "comment": "按文件大小排序"
        },
        {
          "cmd": "ls -lt",
          "comment": "按修改时间倒序(最新在前)"
        }
      ],
      "tags": [
        "目录",
        "列表",
        "文件"
      ]
    },
    {
      "id": "cd",
      "cmd": "cd",
      "cat": "linux",
      "desc": "切换工作目录",
      "syntax": "cd [dir]",
      "args": [
        {
          "name": "..",
          "desc": "上一级"
        },
        {
          "name": "~",
          "desc": "家目录"
        },
        {
          "name": "-",
          "desc": "上一个目录"
        }
      ],
      "examples": [
        {
          "cmd": "cd /var/log",
          "comment": "进入绝对路径目录"
        },
        {
          "cmd": "cd ..",
          "comment": "返回上一级目录"
        },
        {
          "cmd": "cd ~",
          "comment": "回到用户家目录"
        },
        {
          "cmd": "cd -",
          "comment": "切换回上一个目录"
        },
        {
          "cmd": "cd ~/projects && pwd",
          "comment": "进入目录并确认"
        }
      ],
      "tags": [
        "目录",
        "切换"
      ]
    },
    {
      "id": "pwd",
      "cmd": "pwd",
      "cat": "linux",
      "desc": "打印当前工作目录",
      "syntax": "pwd",
      "args": [],
      "examples": [
        {
          "cmd": "pwd",
          "comment": "输出当前绝对路径"
        },
        {
          "cmd": "echo $PWD",
          "comment": "用环境变量读取当前目录"
        },
        {
          "cmd": "cd $(dirname $(pwd))/..",
          "comment": "基于 pwd 计算上级目录"
        }
      ],
      "tags": [
        "目录"
      ]
    },
    {
      "id": "cp",
      "cmd": "cp",
      "cat": "linux",
      "desc": "复制文件或目录",
      "syntax": "cp [-r] source dest",
      "args": [
        {
          "name": "-r",
          "desc": "递归复制目录"
        },
        {
          "name": "-i",
          "desc": "覆盖前询问"
        }
      ],
      "examples": [
        {
          "cmd": "cp app.conf app.conf.bak",
          "comment": "备份配置文件"
        },
        {
          "cmd": "cp -r build/ dist/",
          "comment": "递归复制目录"
        },
        {
          "cmd": "cp -i secret.key secret2.key",
          "comment": "覆盖前先确认"
        },
        {
          "cmd": "cp *.log /tmp/backup/",
          "comment": "批量复制日志文件"
        },
        {
          "cmd": "cp -r src/ src-copy/",
          "comment": "复制整个源码目录"
        }
      ],
      "tags": [
        "复制",
        "文件"
      ]
    },
    {
      "id": "mv",
      "cmd": "mv",
      "cat": "linux",
      "desc": "移动或重命名",
      "syntax": "mv source dest",
      "args": [
        {
          "name": "-i",
          "desc": "覆盖前询问"
        },
        {
          "name": "-n",
          "desc": "不覆盖已存在"
        }
      ],
      "examples": [
        {
          "cmd": "mv old.txt new.txt",
          "comment": "重命名文件"
        },
        {
          "cmd": "mv app.jar /opt/apps/",
          "comment": "移动到目标目录"
        },
        {
          "cmd": "mv -i data.db /var/lib/db/",
          "comment": "覆盖前确认"
        },
        {
          "cmd": "mv -n file.txt dest/",
          "comment": "目标已存在则不移动"
        },
        {
          "cmd": "mv *.log logs/",
          "comment": "批量移动日志"
        }
      ],
      "tags": [
        "移动",
        "重命名"
      ]
    },
    {
      "id": "rm",
      "cmd": "rm",
      "cat": "linux",
      "desc": "删除文件或目录",
      "syntax": "rm [-rf] target",
      "args": [
        {
          "name": "-r",
          "desc": "递归删除目录"
        },
        {
          "name": "-f",
          "desc": "强制不询问"
        }
      ],
      "examples": [
        {
          "cmd": "rm temp.txt",
          "comment": "删除单个文件"
        },
        {
          "cmd": "rm -r node_modules/",
          "comment": "递归删除目录"
        },
        {
          "cmd": "rm -rf build/",
          "comment": "强制删除目录(慎用)"
        },
        {
          "cmd": "rm -i *.log",
          "comment": "逐个确认后删除"
        },
        {
          "cmd": "rm -rf /tmp/cache/*",
          "comment": "清空缓存目录内容"
        }
      ],
      "tags": [
        "删除"
      ]
    },
    {
      "id": "mkdir",
      "cmd": "mkdir",
      "cat": "linux",
      "desc": "创建目录",
      "syntax": "mkdir [-p] dir",
      "args": [
        {
          "name": "-p",
          "desc": "递归创建父目录"
        }
      ],
      "examples": [
        {
          "cmd": "mkdir assets",
          "comment": "创建单个目录"
        },
        {
          "cmd": "mkdir -p a/b/c",
          "comment": "一次创建多级目录"
        },
        {
          "cmd": "mkdir -p /opt/{app,logs,backup}",
          "comment": "花括号批量创建"
        },
        {
          "cmd": "mkdir -m 755 public",
          "comment": "创建并指定权限"
        }
      ],
      "tags": [
        "目录",
        "创建"
      ]
    },
    {
      "id": "touch",
      "cmd": "touch",
      "cat": "linux",
      "desc": "创建空文件或更新时间戳",
      "syntax": "touch file",
      "args": [],
      "examples": [
        {
          "cmd": "touch .gitkeep",
          "comment": "创建占位空文件"
        },
        {
          "cmd": "touch main.go",
          "comment": "新建空源码文件"
        },
        {
          "cmd": "touch app.log",
          "comment": "刷新已有文件时间戳"
        },
        {
          "cmd": "touch {a,b,c}.txt",
          "comment": "一次创建多个文件"
        }
      ],
      "tags": [
        "文件",
        "创建"
      ]
    },
    {
      "id": "grep",
      "cmd": "grep",
      "cat": "linux",
      "desc": "按模式搜索文本",
      "syntax": "grep [-rin] pattern [file...]",
      "args": [
        {
          "name": "-r",
          "desc": "递归目录"
        },
        {
          "name": "-i",
          "desc": "忽略大小写"
        },
        {
          "name": "-n",
          "desc": "显示行号"
        }
      ],
      "examples": [
        {
          "cmd": "grep 'ERROR' app.log",
          "comment": "在日志中查错误"
        },
        {
          "cmd": "grep -rn 'TODO' src/",
          "comment": "递归搜索源码中的 TODO"
        },
        {
          "cmd": "grep -in 'timeout' config.ini",
          "comment": "忽略大小写查找"
        },
        {
          "cmd": "grep -n 'port' nginx.conf",
          "comment": "带行号定位配置项"
        },
        {
          "cmd": "ps aux | grep -v grep | grep java",
          "comment": "排除 grep 自身找 java 进程"
        },
        {
          "cmd": "grep -rl 'debug' src/",
          "comment": "只输出包含匹配的文件名"
        }
      ],
      "tags": [
        "搜索",
        "文本"
      ]
    },
    {
      "id": "find",
      "cmd": "find",
      "cat": "linux",
      "desc": "按条件查找文件",
      "syntax": "find path -name pattern",
      "args": [
        {
          "name": "-name",
          "desc": "按名字(支持通配符)"
        },
        {
          "name": "-type f/d",
          "desc": "按类型"
        },
        {
          "name": "-exec",
          "desc": "对结果执行命令"
        }
      ],
      "examples": [
        {
          "cmd": "find . -name '*.log' -type f",
          "comment": "找所有日志文件"
        },
        {
          "cmd": "find /var -name '*.conf'",
          "comment": "按名字查找配置文件"
        },
        {
          "cmd": "find . -type d -name node_modules",
          "comment": "找所有 node_modules 目录"
        },
        {
          "cmd": "find . -name '*.tmp' -exec rm {} \\;",
          "comment": "删除所有临时文件"
        },
        {
          "cmd": "find . -mtime -7 -name '*.py'",
          "comment": "找一周内修改的 py 文件"
        },
        {
          "cmd": "find . -type f -size +100M",
          "comment": "找大于 100MB 的大文件"
        }
      ],
      "tags": [
        "查找",
        "文件"
      ]
    },
    {
      "id": "cat",
      "cmd": "cat",
      "cat": "linux",
      "desc": "查看/拼接文件内容",
      "syntax": "cat [-n] file",
      "args": [
        {
          "name": "-n",
          "desc": "带行号"
        }
      ],
      "examples": [
        {
          "cmd": "cat /etc/hosts",
          "comment": "查看 hosts 文件"
        },
        {
          "cmd": "cat -n Dockerfile",
          "comment": "带行号查看"
        },
        {
          "cmd": "cat a.txt b.txt > merged.txt",
          "comment": "拼接多个文件"
        },
        {
          "cmd": "cat file.log | grep error",
          "comment": "配合管道过滤"
        },
        {
          "cmd": "cat > config.yaml <<EOF",
          "comment": "交互式创建文件"
        }
      ],
      "tags": [
        "查看",
        "文件"
      ]
    },
    {
      "id": "tail",
      "cmd": "tail",
      "cat": "linux",
      "desc": "查看文件末尾",
      "syntax": "tail [-f] [-n N] file",
      "args": [
        {
          "name": "-f",
          "desc": "持续跟随新内容"
        },
        {
          "name": "-n",
          "desc": "末尾 N 行"
        }
      ],
      "examples": [
        {
          "cmd": "tail app.log",
          "comment": "看末尾 10 行"
        },
        {
          "cmd": "tail -f app.log",
          "comment": "实时跟踪日志"
        },
        {
          "cmd": "tail -n 100 error.log",
          "comment": "看末尾 100 行"
        },
        {
          "cmd": "tail -f access.log | grep 500",
          "comment": "实时过滤 500 错误"
        },
        {
          "cmd": "tail -f /var/log/system.log",
          "comment": "跟踪系统日志"
        }
      ],
      "tags": [
        "日志",
        "查看"
      ]
    },
    {
      "id": "head",
      "cmd": "head",
      "cat": "linux",
      "desc": "查看文件开头",
      "syntax": "head [-n N] file",
      "args": [
        {
          "name": "-n",
          "desc": "前 N 行"
        }
      ],
      "examples": [
        {
          "cmd": "head config.yml",
          "comment": "看前 10 行"
        },
        {
          "cmd": "head -n 20 config.yml",
          "comment": "看前 20 行"
        },
        {
          "cmd": "head -n 5 *.csv",
          "comment": "看多个文件头部"
        },
        {
          "cmd": "head -c 1000 file.bin",
          "comment": "看前 1000 字节"
        }
      ],
      "tags": [
        "查看",
        "文件"
      ]
    },
    {
      "id": "less",
      "cmd": "less",
      "cat": "linux",
      "desc": "分页查看(支持回翻/搜索)",
      "syntax": "less file",
      "args": [
        {
          "name": "q",
          "desc": "退出"
        },
        {
          "name": "/pattern",
          "desc": "页内搜索"
        }
      ],
      "examples": [
        {
          "cmd": "less app.log",
          "comment": "分页浏览大日志"
        },
        {
          "cmd": "less -N app.log",
          "comment": "带行号分页查看"
        },
        {
          "cmd": "less README.md",
          "comment": "阅读文档(按 / 搜索)"
        },
        {
          "cmd": "grep -r error . | less",
          "comment": "搜索结果分页浏览"
        }
      ],
      "tags": [
        "分页",
        "查看"
      ]
    },
    {
      "id": "more",
      "cmd": "more",
      "cat": "linux",
      "desc": "简单分页查看",
      "syntax": "more file",
      "args": [
        {
          "name": "空格",
          "desc": "下一页"
        },
        {
          "name": "q",
          "desc": "退出"
        }
      ],
      "examples": [
        {
          "cmd": "more README.md",
          "comment": "分页读文档"
        },
        {
          "cmd": "ps aux | more",
          "comment": "进程列表分页查看"
        },
        {
          "cmd": "more -10 install.log",
          "comment": "每屏显示 10 行"
        }
      ],
      "tags": [
        "分页",
        "查看"
      ]
    },
    {
      "id": "echo",
      "cmd": "echo",
      "cat": "linux",
      "desc": "输出文本或变量值",
      "syntax": "echo [text] [-e]",
      "args": [
        {
          "name": "-e",
          "desc": "解释转义字符"
        }
      ],
      "examples": [
        {
          "cmd": "echo 'Hello World'",
          "comment": "输出字符串"
        },
        {
          "cmd": "echo $PATH",
          "comment": "打印环境变量"
        },
        {
          "cmd": "echo -e 'a\\nb\\nc'",
          "comment": "解释换行转义"
        },
        {
          "cmd": "echo $? ",
          "comment": "查看上一条命令退出码"
        },
        {
          "cmd": "echo \"构建完成: $(date)\"",
          "comment": "嵌入命令替换输出"
        }
      ],
      "tags": [
        "输出"
      ]
    },
    {
      "id": "export",
      "cmd": "export",
      "cat": "linux",
      "desc": "设置/导出环境变量",
      "syntax": "export NAME=value",
      "args": [],
      "examples": [
        {
          "cmd": "export KUBECONFIG=~/.kube/dev.yaml",
          "comment": "切换 kubeconfig"
        },
        {
          "cmd": "export PATH=$PATH:/opt/bin",
          "comment": "追加 PATH 路径"
        },
        {
          "cmd": "export NODE_ENV=production",
          "comment": "设置运行环境"
        },
        {
          "cmd": "export JAVA_HOME=$(/usr/libexec/java_home)",
          "comment": "macOS 自动定位 JDK"
        },
        {
          "cmd": "env | grep EXPORTED",
          "comment": "验证变量已生效"
        }
      ],
      "tags": [
        "环境变量"
      ]
    },
    {
      "id": "env",
      "cmd": "env",
      "cat": "linux",
      "desc": "查看环境变量",
      "syntax": "env",
      "args": [],
      "examples": [
        {
          "cmd": "env",
          "comment": "列出全部环境变量"
        },
        {
          "cmd": "env | grep PATH",
          "comment": "过滤查看"
        },
        {
          "cmd": "env | sort",
          "comment": "排序后查看"
        },
        {
          "cmd": "env -i bash",
          "comment": "干净环境启动 shell"
        }
      ],
      "tags": [
        "环境变量"
      ]
    },
    {
      "id": "alias",
      "cmd": "alias",
      "cat": "linux",
      "desc": "定义/查看命令别名",
      "syntax": "alias name='command'",
      "args": [],
      "examples": [
        {
          "cmd": "alias k='kubectl'",
          "comment": "k 替代 kubectl"
        },
        {
          "cmd": "alias ll='ls -lah'",
          "comment": "常用缩写"
        },
        {
          "cmd": "alias",
          "comment": "查看所有别名"
        },
        {
          "cmd": "alias grep='grep --color'",
          "comment": "grep 默认高亮"
        },
        {
          "cmd": "unalias k",
          "comment": "删除别名"
        }
      ],
      "tags": [
        "别名"
      ]
    },
    {
      "id": "ps",
      "cmd": "ps",
      "cat": "linux",
      "desc": "查看进程列表",
      "syntax": "ps [-ef] | grep <name>",
      "args": [
        {
          "name": "-ef",
          "desc": "全部进程完整信息"
        },
        {
          "name": "aux",
          "desc": "BSD 风格"
        }
      ],
      "examples": [
        {
          "cmd": "ps aux | grep node",
          "comment": "找 node 进程"
        },
        {
          "cmd": "ps -ef | grep nginx",
          "comment": "查看 nginx 进程树"
        },
        {
          "cmd": "ps aux --sort=-%mem | head",
          "comment": "按内存占用排序"
        },
        {
          "cmd": "ps -p 1234 -o pid,cmd,%cpu",
          "comment": "查看指定进程详情"
        },
        {
          "cmd": "ps aux | grep java | grep -v grep",
          "comment": "精确找 java 进程"
        }
      ],
      "tags": [
        "进程"
      ]
    },
    {
      "id": "kill",
      "cmd": "kill",
      "cat": "linux",
      "desc": "终止进程",
      "syntax": "kill [-9] <pid>",
      "args": [
        {
          "name": "-9",
          "desc": "强制杀死"
        },
        {
          "name": "-15",
          "desc": "优雅终止(默认)"
        }
      ],
      "examples": [
        {
          "cmd": "kill 1234",
          "comment": "默认 TERM 信号终止"
        },
        {
          "cmd": "kill -9 1234",
          "comment": "强制结束 PID 1234"
        },
        {
          "cmd": "kill -15 1234",
          "comment": "优雅终止(默认)"
        },
        {
          "cmd": "pkill -f node server.js",
          "comment": "按命令行模式杀进程"
        },
        {
          "cmd": "kill $(pgrep -f 'node app')",
          "comment": "批量结束匹配进程"
        }
      ],
      "tags": [
        "进程"
      ]
    },
    {
      "id": "top",
      "cmd": "top",
      "cat": "linux",
      "desc": "实时进程监控",
      "syntax": "top [-o cpu]",
      "args": [
        {
          "name": "q",
          "desc": "退出"
        },
        {
          "name": "-o",
          "desc": "排序字段"
        }
      ],
      "examples": [
        {
          "cmd": "top",
          "comment": "进入实时监控"
        },
        {
          "cmd": "top -o cpu",
          "comment": "按 CPU 排序"
        },
        {
          "cmd": "top -o mem",
          "comment": "按内存排序"
        },
        {
          "cmd": "top -p 1234",
          "comment": "只看指定进程"
        },
        {
          "cmd": "htop",
          "comment": "更友好的替代工具"
        }
      ],
      "tags": [
        "监控",
        "进程"
      ]
    },
    {
      "id": "df",
      "cmd": "df",
      "cat": "linux",
      "desc": "查看磁盘空间",
      "syntax": "df -h",
      "args": [
        {
          "name": "-h",
          "desc": "人类可读"
        }
      ],
      "examples": [
        {
          "cmd": "df -h",
          "comment": "查看各挂载点用量"
        },
        {
          "cmd": "df -h /data",
          "comment": "查看指定目录所在盘"
        },
        {
          "cmd": "df -i",
          "comment": "查看 inode 使用率"
        },
        {
          "cmd": "df -h | sort -k5 -rn",
          "comment": "按使用率排序"
        }
      ],
      "tags": [
        "磁盘"
      ]
    },
    {
      "id": "du",
      "cmd": "du",
      "cat": "linux",
      "desc": "查看目录占用",
      "syntax": "du -sh <dir>",
      "args": [
        {
          "name": "-s",
          "desc": "总计"
        },
        {
          "name": "-h",
          "desc": "人类可读"
        }
