      ]
    },
    {
      "id": "docker-compose-inspect",
      "cmd": "docker compose inspect",
      "cat": "docker",
      "desc": "查看 compose 服务详情",
      "syntax": "docker compose inspect [service]",
      "args": [],
      "examples": [
        {
          "cmd": "docker compose inspect web",
          "comment": "查看服务详细配置"
        },
        {
          "cmd": "docker compose inspect",
          "comment": "查看全部服务配置"
        },
        {
          "cmd": "docker compose inspect web | grep -i image",
