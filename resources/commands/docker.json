      "desc": "查看 compose 服务进程",
      "syntax": "docker compose top",
      "args": [],
      "examples": [
        {
          "cmd": "docker compose top",
          "comment": "查看全部服务进程"
        },
        {
          "cmd": "docker compose top web",
          "comment": "查看指定服务进程"
        },
        {
          "cmd": "docker compose top | grep java",
          "comment": "过滤指定进程"
        }
      ],
      "tags": [
        "compose",
        "进程"
      ]
    },
    {
      "id": "docker-compose-stats",
      "cmd": "docker compose stats",
      "cat": "docker",
      "desc": "实时资源占用(compose)",
      "syntax": "docker compose stats",
      "args": [],
      "examples": [
        {
          "cmd": "docker compose stats",
          "comment": "实时查看资源占用"
        },
        {
          "cmd": "docker compose stats web",
          "comment": "只看指定服务"
        },
        {
          "cmd": "docker compose stats --no-stream",
          "comment": "单次输出不刷新"
        },
        {
          "cmd": "docker stats",
          "comment": "全部容器视角"
