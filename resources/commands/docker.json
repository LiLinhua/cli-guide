[
  { "id": "docker-run", "cmd": "docker run", "cat": "docker", "desc": "运行容器",
    "syntax": "docker run [-it] [-d] [-p 端口映射] [--rm] image [cmd]",
    "args": [ { "name": "-it", "desc": "交互终端" }, { "name": "-d", "desc": "后台运行" }, { "name": "-p", "desc": "端口映射" }, { "name": "--rm", "desc": "退出后自动删除" } ],
    "examples": [ { "cmd": "docker run -it --rm ubuntu bash", "comment": "临时交互容器" } ],
    "tags": ["docker", "容器", "运行"] },
  { "id": "docker-ps", "cmd": "docker ps", "cat": "docker", "desc": "列出容器",
    "syntax": "docker ps [-a]",
    "args": [ { "name": "-a", "desc": "含已停止" }, { "name": "-q", "desc": "只输 ID" } ],
    "examples": [ { "cmd": "docker ps -a", "comment": "查看全部容器" } ],
    "tags": ["docker", "容器", "列表"] },
