{
  "cat": "docker",
  "label": "docker 命令",
  "order": 7,
  "commands": [
    {
      "id": "docker-run",
      "cmd": "docker run",
      "cat": "docker",
      "desc": "运行容器",
      "syntax": "docker run [-it] [-d] [-p 端口映射] [--rm] image [cmd]",
      "args": [
        {
          "name": "-it",
          "desc": "交互终端"
        },
        {
          "name": "-d",
          "desc": "后台运行"
        },
        {
          "name": "-p",
          "desc": "端口映射"
        },
        {
          "name": "--rm",
          "desc": "退出后自动删除"
        }
      ],
      "examples": [
        {
          "cmd": "docker run -it --rm ubuntu bash",
          "comment": "临时交互容器"
        },
        {
          "cmd": "docker run -d --name web -p 8080:80 nginx",
          "comment": "后台运行并映射端口"
        },
        {
          "cmd": "docker run -d --name db -p 3306:3306 -e MYSQL_ROOT_PASSWORD=123 mysql:8",
          "comment": "传环境变量运行"
        },
        {
          "cmd": "docker run --rm -v $(pwd):/app -w /app node:20 npm test",
          "comment": "挂载目录运行测试"
        },
        {
          "cmd": "docker run -d --name redis -p 6379:6379 --restart=always redis",
          "comment": "开机自启容器"
        },
        {
          "cmd": "docker run --network host -d nginx",
          "comment": "使用宿主机网络"
        },
        {
          "cmd": "docker run --name ubuntu alpine echo hello",
          "comment": "运行一次性命令"
        }
      ],
      "tags": [
        "docker",
        "容器",
        "运行"
      ]
    },
    {
      "id": "docker-ps",
      "cmd": "docker ps",
      "cat": "docker",
      "desc": "列出容器",
      "syntax": "docker ps [-a]",
      "args": [
        {
          "name": "-a",
          "desc": "含已停止"
        },
        {
          "name": "-q",
          "desc": "只输 ID"
        }
      ],
      "examples": [
        {
          "cmd": "docker ps",
          "comment": "查看运行中容器"
        },
        {
          "cmd": "docker ps -a",
          "comment": "查看全部容器"
        },
        {
          "cmd": "docker ps -q",
          "comment": "只输出容器 ID"
        },
        {
          "cmd": "docker ps --filter ancestor=nginx",
          "comment": "按镜像过滤"
        },
        {
          "cmd": "docker ps --format 'table {{.Names}}\\t{{.Status}}'",
          "comment": "自定义列输出"
        },
        {
          "cmd": "docker ps -a --filter status=exited",
          "comment": "只看已退出的容器"
        }
      ],
      "tags": [
        "docker",
        "容器",
        "列表"
      ]
    },
    {
      "id": "docker-images",
      "cmd": "docker images",
      "cat": "docker",
      "desc": "列出镜像",
      "syntax": "docker images",
      "args": [],
      "examples": [
        {
          "cmd": "docker images",
          "comment": "查看本地镜像列表"
        },
        {
          "cmd": "docker images nginx",
          "comment": "按名字过滤"
        },
        {
          "cmd": "docker images --format 'table {{.Repository}}\\t{{.Tag}}\\t{{.Size}}'",
          "comment": "自定义列输出"
        },
        {
          "cmd": "docker images -a",
          "comment": "含中间层镜像"
        },
        {
          "cmd": "docker image ls --filter dangling=true",
          "comment": "查看悬空镜像"
        }
      ],
      "tags": [
        "docker",
        "镜像"
      ]
    },
    {
      "id": "docker-build",
      "cmd": "docker build",
      "cat": "docker",
      "desc": "构建镜像",
      "syntax": "docker build -t <name> .",
      "args": [
        {
          "name": "-t",
          "desc": "镜像标签"
        },
        {
          "name": "--no-cache",
          "desc": "禁用缓存"
        }
      ],
      "examples": [
        {
          "cmd": "docker build -t myapp:v1 .",
          "comment": "构建并打标签"
        },
        {
          "cmd": "docker build -t myapp:latest -f Dockerfile.prod .",
          "comment": "指定 Dockerfile 构建"
        },
        {
          "cmd": "docker build --no-cache -t myapp:v2 .",
          "comment": "禁用缓存全量构建"
        },
        {
          "cmd": "docker build -t myapp --build-arg VERSION=1.2 .",
          "comment": "传入构建参数"
        },
        {
          "cmd": "docker build --platform linux/amd64 -t myapp .",
          "comment": "指定平台构建"
        }
      ],
      "tags": [
        "docker",
        "镜像",
        "构建"
      ]
    },
    {
      "id": "docker-exec",
      "cmd": "docker exec",
      "cat": "docker",
      "desc": "进入运行中容器",
      "syntax": "docker exec -it <container> bash",
      "args": [
        {
          "name": "-it",
          "desc": "交互终端"
        }
      ],
      "examples": [
        {
          "cmd": "docker exec -it myapp bash",
          "comment": "进入容器调试"
        },
        {
          "cmd": "docker exec myapp ls /etc/nginx",
          "comment": "容器内执行单条命令"
        },
        {
          "cmd": "docker exec -it db mysql -uroot -p",
          "comment": "进入数据库容器"
        },
        {
          "cmd": "docker exec -u root myapp cat /etc/hosts",
          "comment": "指定用户执行"
        },
        {
          "cmd": "docker exec -w /app myapp npm install",
          "comment": "指定工作目录执行"
        }
      ],
      "tags": [
        "docker",
        "容器",
        "调试"
      ]
    },
    {
      "id": "docker-logs",
      "cmd": "docker logs",
      "cat": "docker",
      "desc": "查看容器日志",
      "syntax": "docker logs [-f] [--tail N] <container>",
      "args": [
        {
          "name": "-f",
          "desc": "持续跟踪"
        },
        {
          "name": "--tail",
          "desc": "末尾 N 行"
        }
      ],
      "examples": [
        {
          "cmd": "docker logs myapp",
          "comment": "查看容器全部日志"
        },
        {
          "cmd": "docker logs -f --tail 100 myapp",
          "comment": "跟踪最近 100 行日志"
        },
        {
          "cmd": "docker logs --since 10m myapp",
          "comment": "看最近 10 分钟日志"
        },
        {
          "cmd": "docker logs --tail 50 --timestamps web",
          "comment": "带时间戳看日志"
        },
        {
          "cmd": "docker logs myapp 2>&1 | grep ERROR",
          "comment": "过滤错误日志"
        }
      ],
      "tags": [
        "docker",
        "日志"
      ]
    },
    {
      "id": "docker-stop",
      "cmd": "docker stop",
      "cat": "docker",
      "desc": "停止容器",
      "syntax": "docker stop <container>",
      "args": [],
      "examples": [
        {
          "cmd": "docker stop myapp",
          "comment": "优雅停止容器"
        },
        {
          "cmd": "docker stop web db",
          "comment": "一次停止多个容器"
        },
        {
          "cmd": "docker stop $(docker ps -q)",
          "comment": "停止所有运行中容器"
        },
        {
          "cmd": "docker stop -t 10 myapp",
          "comment": "10 秒超时后强杀"
        },
        {
          "cmd": "docker ps -a | grep Exited",
          "comment": "确认停止状态"
        }
      ],
      "tags": [
        "docker",
        "容器"
      ]
    },
    {
      "id": "docker-rm",
      "cmd": "docker rm",
      "cat": "docker",
      "desc": "删除容器",
      "syntax": "docker rm [-f] <container>",
      "args": [
        {
          "name": "-f",
          "desc": "强制删除运行中容器"
        }
      ],
      "examples": [
        {
          "cmd": "docker rm myapp",
          "comment": "删除已停止容器"
        },
        {
          "cmd": "docker rm -f myapp",
          "comment": "强制删除容器"
        },
        {
          "cmd": "docker rm $(docker ps -aq)",
          "comment": "删除全部容器"
        },
        {
          "cmd": "docker rm -f $(docker ps -aq --filter status=exited)",
          "comment": "清理所有已退出容器"
        }
      ],
      "tags": [
        "docker",
        "容器",
        "删除"
      ]
    },
    {
      "id": "docker-rmi",
      "cmd": "docker rmi",
      "cat": "docker",
      "desc": "删除镜像",
      "syntax": "docker rmi <image>",
      "args": [],
      "examples": [
        {
          "cmd": "docker rmi myapp:v1",
          "comment": "删除本地镜像"
        },
        {
          "cmd": "docker rmi nginx:alpine",
          "comment": "按标签删除"
        },
        {
          "cmd": "docker rmi $(docker images -q -f dangling=true)",
          "comment": "批量删除悬空镜像"
        },
        {
          "cmd": "docker rmi -f myapp:v1",
          "comment": "强制删除(有容器引用时)"
        }
      ],
      "tags": [
        "docker",
        "镜像",
        "删除"
      ]
    },
    {
      "id": "docker-pull",
      "cmd": "docker pull",
      "cat": "docker",
      "desc": "拉取镜像",
      "syntax": "docker pull <image>",
      "args": [],
      "examples": [
        {
          "cmd": "docker pull nginx:alpine",
          "comment": "拉取 nginx 镜像"
        },
        {
          "cmd": "docker pull ubuntu:22.04",
          "comment": "拉取指定版本"
        },
        {
          "cmd": "docker pull mysql:8 --platform linux/arm64",
          "comment": "拉取指定架构镜像"
        },
        {
          "cmd": "docker pull registry.example.com/app:v1",
          "comment": "从私有仓库拉取"
        }
      ],
      "tags": [
        "docker",
        "镜像"
      ]
    },
    {
      "id": "docker-network",
      "cmd": "docker network",
      "cat": "docker",
      "desc": "网络管理",
      "syntax": "docker network ls | create | connect",
      "args": [],
      "examples": [
        {
          "cmd": "docker network ls",
          "comment": "查看网络列表"
        },
        {
          "cmd": "docker network create app-net",
          "comment": "创建自定义网络"
        },
        {
          "cmd": "docker network connect app-net myapp",
          "comment": "容器接入网络"
        },
        {
          "cmd": "docker run -d --network app-net --name api myapp",
          "comment": "指定网络运行容器"
        },
        {
          "cmd": "docker network inspect app-net",
          "comment": "查看网络详情"
        },
        {
          "cmd": "docker network rm app-net",
          "comment": "删除网络"
        }
      ],
      "tags": [
        "docker",
        "网络"
      ]
    },
    {
      "id": "docker-volume",
      "cmd": "docker volume",
      "cat": "docker",
      "desc": "卷管理",
      "syntax": "docker volume ls | create | prune",
      "args": [],
      "examples": [
        {
          "cmd": "docker volume ls",
          "comment": "查看卷列表"
        },
        {
          "cmd": "docker volume create db-data",
          "comment": "创建命名卷"
        },
        {
          "cmd": "docker run -d -v db-data:/var/lib/mysql mysql:8",
          "comment": "挂载命名卷持久化"
        },
        {
          "cmd": "docker volume inspect db-data",
          "comment": "查看卷详情"
        },
        {
          "cmd": "docker volume prune",
          "comment": "清理未使用卷"
        },
        {
          "cmd": "docker run -d -v $(pwd)/data:/data nginx",
          "comment": "挂载宿主机目录"
        }
      ],
      "tags": [
        "docker",
        "存储",
        "卷"
      ]
    },
    {
      "id": "docker-compose-up",
      "cmd": "docker compose up",
      "cat": "docker",
      "desc": "启动 compose 服务",
      "syntax": "docker compose up [-d] [--build]",
      "args": [
        {
          "name": "-d",
          "desc": "后台运行"
        },
        {
          "name": "--build",
          "desc": "先构建镜像"
        }
      ],
      "examples": [
        {
          "cmd": "docker compose up -d",
          "comment": "后台启动全部服务"
        },
        {
          "cmd": "docker compose up -d --build",
          "comment": "重新构建后启动"
        },
        {
          "cmd": "docker compose up -d db",
          "comment": "只启动指定服务"
        },
        {
          "cmd": "docker compose up",
          "comment": "前台启动(看日志)"
        },
        {
          "cmd": "docker compose up -d --scale web=3",
          "comment": "指定副本数启动"
        }
      ],
      "tags": [
        "compose",
        "启动"
      ]
    },
    {
      "id": "docker-compose-down",
      "cmd": "docker compose down",
      "cat": "docker",
      "desc": "停止并移除 compose 服务",
      "syntax": "docker compose down [-v]",
      "args": [
        {
          "name": "-v",
          "desc": "连卷一起删"
        }
      ],
      "examples": [
        {
          "cmd": "docker compose down",
          "comment": "停止并移除服务"
        },
        {
          "cmd": "docker compose down -v",
          "comment": "连同数据卷一起删除"
        },
        {
          "cmd": "docker compose down --rmi all",
          "comment": "连镜像一起删除"
        },
        {
          "cmd": "docker compose down --remove-orphans",
          "comment": "移除无关联容器"
        },
        {
          "cmd": "docker compose stop",
          "comment": "只停止不删除(保留数据)"
        }
      ],
      "tags": [
        "compose",
        "停止"
      ]
    },
    {
      "id": "docker-compose-ps",
      "cmd": "docker compose ps",
      "cat": "docker",
      "desc": "查看 compose 服务状态",
      "syntax": "docker compose ps",
      "args": [],
      "examples": [
        {
          "cmd": "docker compose ps",
          "comment": "查看服务运行状态"
        },
        {
          "cmd": "docker compose ps -a",
          "comment": "含已停止服务"
        },
        {
          "cmd": "docker compose ps --format json",
          "comment": "JSON 格式输出"
        },
        {
          "cmd": "docker compose ps web",
          "comment": "只看单个服务"
        }
      ],
      "tags": [
        "compose",
        "状态"
      ]
    },
    {
      "id": "docker-compose-logs",
      "cmd": "docker compose logs",
      "cat": "docker",
      "desc": "查看 compose 服务日志",
      "syntax": "docker compose logs [-f] [service]",
      "args": [
        {
          "name": "-f",
          "desc": "持续跟踪"
        }
      ],
      "examples": [
        {
          "cmd": "docker compose logs",
          "comment": "查看全部服务日志"
        },
        {
          "cmd": "docker compose logs -f web",
          "comment": "实时跟踪 web 日志"
        },
        {
          "cmd": "docker compose logs --tail=100 db",
          "comment": "看 db 最近 100 行"
        },
        {
          "cmd": "docker compose logs -f --no-color",
          "comment": "无颜色输出跟踪"
        }
      ],
      "tags": [
        "compose",
        "日志"
      ]
    },
    {
      "id": "docker-compose-exec",
      "cmd": "docker compose exec",
      "cat": "docker",
      "desc": "在 compose 服务内执行命令",
      "syntax": "docker compose exec <service> <cmd>",
      "args": [],
      "examples": [
        {
          "cmd": "docker compose exec web bash",
          "comment": "进入 web 服务"
        },
        {
          "cmd": "docker compose exec db mysql -uroot -p",
          "comment": "进入数据库服务"
        },
        {
          "cmd": "docker compose exec web php artisan migrate",
          "comment": "服务内执行迁移"
        },
        {
          "cmd": "docker compose exec -T db pg_dump -U postgres app > backup.sql",
          "comment": "非交互导出备份"
        }
      ],
      "tags": [
        "compose",
        "执行"
      ]
    },
    {
      "id": "docker-compose-build",
      "cmd": "docker compose build",
      "cat": "docker",
      "desc": "构建 compose 服务镜像",
      "syntax": "docker compose build [service]",
      "args": [],
      "examples": [
        {
          "cmd": "docker compose build",
          "comment": "构建全部服务镜像"
        },
        {
          "cmd": "docker compose build web",
          "comment": "只构建指定服务"
        },
        {
          "cmd": "docker compose build --no-cache web",
          "comment": "禁用缓存构建"
        },
        {
          "cmd": "docker compose build --parallel",
          "comment": "并行构建"
        }
      ],
      "tags": [
        "compose",
        "构建"
      ]
    },
    {
      "id": "docker-compose-pull",
      "cmd": "docker compose pull",
      "cat": "docker",
      "desc": "拉取 compose 服务镜像",
      "syntax": "docker compose pull",
      "args": [],
      "examples": [
        {
          "cmd": "docker compose pull",
          "comment": "拉取全部服务镜像"
        },
        {
          "cmd": "docker compose pull web db",
          "comment": "拉取指定服务镜像"
        },
        {
          "cmd": "docker compose pull --ignore-pull-failures",
          "comment": "忽略拉取失败继续"
        },
        {
          "cmd": "docker compose up -d --pull always",
          "comment": "启动时总是拉最新镜像"
        }
      ],
      "tags": [
        "compose",
        "拉取"
      ]
    },
    {
      "id": "docker-compose-stop",
      "cmd": "docker compose stop",
      "cat": "docker",
      "desc": "停止 compose 服务(不删除)",
      "syntax": "docker compose stop [service]",
      "args": [],
      "examples": [
        {
          "cmd": "docker compose stop",
          "comment": "停止全部服务"
        },
        {
          "cmd": "docker compose stop web",
          "comment": "停止指定服务"
        },
        {
          "cmd": "docker compose stop -t 10",
          "comment": "10 秒超时停止"
        },
        {
          "cmd": "docker compose start",
          "comment": "重新启动已停止服务"
        }
      ],
      "tags": [
        "compose",
        "停止"
      ]
    },
    {
      "id": "docker-compose-start",
      "cmd": "docker compose start",
      "cat": "docker",
      "desc": "启动已停止的 compose 服务",
      "syntax": "docker compose start [service]",
      "args": [],
      "examples": [
        {
          "cmd": "docker compose start",
          "comment": "启动全部已停止服务"
        },
        {
          "cmd": "docker compose start web",
          "comment": "启动指定服务"
        },
        {
          "cmd": "docker compose start && docker compose ps",
