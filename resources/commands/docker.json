      "cmd": "docker compose restart",
      "cat": "docker",
      "desc": "重启 compose 服务",
      "syntax": "docker compose restart [service]",
      "args": [],
      "examples": [
        {
          "cmd": "docker compose restart",
          "comment": "重启全部服务"
        },
        {
          "cmd": "docker compose restart web",
          "comment": "重启指定服务"
