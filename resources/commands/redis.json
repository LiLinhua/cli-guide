      ]
    },
    {
      "id": "redis-lpush",
      "cmd": "LPUSH",
      "cat": "redis",
      "desc": "头部压入列表",
      "syntax": "LPUSH <key> <value> [value...]",
      "args": [],
      "examples": [
        {
          "cmd": "LPUSH queue:task task-1",
          "comment": "任务入队"
        },
        {
          "cmd": "LPUSH logs:app 'error: timeout'",
          "comment": "日志头部插入"
        },
        {
          "cmd": "RPUSH queue:task task-2",
          "comment": "尾部入队(FIFO 队列)"
        },
        {
          "cmd": "LRANGE queue:task 0 -1",
