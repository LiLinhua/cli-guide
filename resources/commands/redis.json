{
  "cat": "redis",
  "label": "redis 命令",
  "order": 11,
  "commands": [
    {
      "id": "redis-server",
      "cmd": "redis-server",
      "cat": "redis",
      "desc": "启动 Redis 服务",
      "syntax": "redis-server [redis.conf] [--port 6379] [--daemonize yes]",
      "args": [],
      "examples": [
        {
          "cmd": "redis-server",
          "comment": "默认配置前台启动"
        },
        {
          "cmd": "redis-server /etc/redis/6379.conf",
          "comment": "指定配置文件启动"
        },
        {
          "cmd": "redis-server --port 6380 --daemonize yes",
          "comment": "指定端口后台启动"
        },
        {
          "cmd": "redis-server --port 6380",
          "comment": "多实例运行"
        },
        {
          "cmd": "redis-cli ping",
          "comment": "启动后验证连通"
        }
      ],
      "tags": [
        "redis",
        "服务"
      ]
    },
    {
      "id": "redis-cli",
      "cmd": "redis-cli",
      "cat": "redis",
      "desc": "连接 Redis 客户端",
      "syntax": "redis-cli [-h <host>] [-p <port>] [-a <password>]",
      "args": [],
      "examples": [
        {
          "cmd": "redis-cli",
          "comment": "连接本机默认端口"
        },
        {
          "cmd": "redis-cli -h 10.0.0.5 -p 6379",
          "comment": "连接远程实例"
        },
        {
          "cmd": "redis-cli -a mypassword",
          "comment": "带密码连接"
        },
        {
          "cmd": "redis-cli -n 2",
          "comment": "连接并选择数据库 2"
        },
        {
          "cmd": "redis-cli --raw get name",
          "comment": "非交互单条执行"
        },
        {
          "cmd": "redis-cli --scan --pattern 'user:*'",
          "comment": "非交互遍历键"
        }
      ],
      "tags": [
        "redis",
        "客户端"
      ]
    },
    {
      "id": "redis-set",
      "cmd": "SET",
      "cat": "redis",
      "desc": "设置字符串键值",
      "syntax": "SET <key> <value> [EX <sec>] [NX]",
      "args": [],
      "examples": [
        {
          "cmd": "SET name '张三'",
          "comment": "设置字符串"
        },
        {
          "cmd": "SET token abc123 EX 3600",
          "comment": "带 1 小时过期"
        },
        {
          "cmd": "SET lock 1 NX",
          "comment": "不存在才设置(分布式锁)"
        },
        {
          "cmd": "SET count 0",
          "comment": "计数器初始化"
        },
        {
          "cmd": "SET user:1 '{\"name\":\"x\"}'",
          "comment": "存 JSON 字符串"
        }
      ],
      "tags": [
        "redis",
        "字符串"
      ]
    },
    {
      "id": "redis-get",
      "cmd": "GET",
      "cat": "redis",
      "desc": "获取字符串值",
      "syntax": "GET <key>",
      "args": [],
      "examples": [
        {
          "cmd": "GET name",
          "comment": "获取字符串值"
        },
        {
          "cmd": "GET token",
          "comment": "获取令牌"
        },
        {
          "cmd": "GET user:1",
          "comment": "获取 JSON 数据"
        },
        {
          "cmd": "GET name | jq .",
          "comment": "管道解析 JSON"
        }
      ],
      "tags": [
        "redis",
        "字符串"
      ]
    },
    {
      "id": "redis-del",
      "cmd": "DEL",
      "cat": "redis",
      "desc": "删除键",
      "syntax": "DEL <key> [key...]",
      "args": [],
      "examples": [
        {
          "cmd": "DEL name",
          "comment": "删除单个键"
        },
        {
          "cmd": "DEL user:1 user:2 token",
          "comment": "批量删除"
        },
        {
          "cmd": "DEL lock",
          "comment": "释放分布式锁"
        },
        {
          "cmd": "UNLINK cache:big",
          "comment": "异步删除大键"
        }
      ],
      "tags": [
        "redis",
        "删除"
      ]
    },
    {
      "id": "redis-exists",
      "cmd": "EXISTS",
      "cat": "redis",
      "desc": "判断键是否存在",
      "syntax": "EXISTS <key>",
      "args": [],
      "examples": [
        {
          "cmd": "EXISTS name",
          "comment": "存在返回 1"
        },
        {
          "cmd": "EXISTS a b c",
          "comment": "统计存在的数量"
        },
        {
          "cmd": "SETNX lock 1 && EXISTS lock",
          "comment": "锁是否持有"
        }
      ],
      "tags": [
        "redis",
        "判断"
      ]
    },
    {
      "id": "redis-expire",
      "cmd": "EXPIRE",
      "cat": "redis",
      "desc": "设置键过期时间",
      "syntax": "EXPIRE <key> <seconds>",
      "args": [],
      "examples": [
        {
          "cmd": "EXPIRE token 1800",
          "comment": "30 分钟后过期"
        },
        {
          "cmd": "EXPIRE session:9f3 86400",
          "comment": "会话 1 天过期"
        },
        {
          "cmd": "SET code 12345 EX 300",
          "comment": "验证码 5 分钟有效"
        },
        {
          "cmd": "TTL token",
          "comment": "确认剩余时间"
        }
      ],
      "tags": [
        "redis",
        "过期"
      ]
    },
    {
      "id": "redis-ttl",
      "cmd": "TTL",
      "cat": "redis",
      "desc": "查看剩余生存时间",
      "syntax": "TTL <key>",
      "args": [],
      "examples": [
        {
          "cmd": "TTL token",
          "comment": "剩余秒数(-1 永不过期)"
        },
        {
          "cmd": "TTL code",
          "comment": "验证码剩余时间"
        },
        {
          "cmd": "TTL session:9f3",
          "comment": "会话剩余时间"
        }
      ],
      "tags": [
        "redis",
        "过期"
      ]
    },
    {
      "id": "redis-persist",
      "cmd": "PERSIST",
      "cat": "redis",
      "desc": "移除过期时间",
      "syntax": "PERSIST <key>",
      "args": [],
      "examples": [
        {
          "cmd": "PERSIST token",
          "comment": "取消过期"
        },
        {
          "cmd": "PERSIST session:9f3",
          "comment": "会话永不过期"
        },
        {
          "cmd": "TTL token",
          "comment": "验证为 -1"
        }
      ],
      "tags": [
        "redis",
        "过期"
      ]
    },
    {
      "id": "redis-incr",
      "cmd": "INCR",
      "cat": "redis",
      "desc": "自增计数",
      "syntax": "INCR <key>",
      "args": [],
      "examples": [
        {
          "cmd": "INCR pageview:home",
          "comment": "页面访问计数"
        },
        {
          "cmd": "INCR likes:post:100",
          "comment": "点赞数"
        },
        {
          "cmd": "INCRBY stock:iphone 5",
          "comment": "按步长增加"
        },
        {
          "cmd": "GET pageview:home",
          "comment": "查看当前计数"
        }
      ],
      "tags": [
        "redis",
        "计数"
      ]
    },
    {
      "id": "redis-decr",
      "cmd": "DECR",
      "cat": "redis",
      "desc": "自减计数",
      "syntax": "DECR <key>",
      "args": [],
      "examples": [
        {
          "cmd": "DECR stock:iphone",
          "comment": "库存减 1"
        },
        {
          "cmd": "DECRBY stock:iphone 3",
          "comment": "按步长减少"
        },
        {
          "cmd": "DECR quota:user:1",
          "comment": "配额递减"
        },
        {
          "cmd": "GET stock:iphone",
          "comment": "查看剩余库存"
        }
      ],
      "tags": [
        "redis",
        "计数"
      ]
    },
    {
      "id": "redis-setnx",
      "cmd": "SETNX",
      "cat": "redis",
      "desc": "不存在时设置(分布式锁)",
      "syntax": "SETNX <key> <value>",
      "args": [],
      "examples": [
        {
          "cmd": "SETNX lock:order 1",
          "comment": "抢锁(成功返回 1)"
        },
        {
          "cmd": "SET lock:order 1 EX 10 NX",
          "comment": "带超时的锁"
        },
        {
          "cmd": "DEL lock:order",
          "comment": "释放锁"
        },
        {
          "cmd": "SET lock:order uuid EX 10 NX",
          "comment": "锁值用唯一标识防误删"
        }
      ],
      "tags": [
        "redis",
        "锁"
      ]
    },
    {
      "id": "redis-keys",
      "cmd": "KEYS",
      "cat": "redis",
      "desc": "按模式匹配键(慎用)",
      "syntax": "KEYS <pattern>",
      "args": [],
      "examples": [
        {
          "cmd": "KEYS user:*",
          "comment": "匹配 user 前缀(生产慎用)"
        },
        {
          "cmd": "KEYS *cache*",
          "comment": "包含 cache 的键"
        },
        {
          "cmd": "KEYS ?b*",
          "comment": "通配单个字符"
        },
        {
          "cmd": "SCAN 0 MATCH user:* COUNT 100",
          "comment": "生产推荐用 SCAN"
        }
      ],
      "tags": [
        "redis",
        "查询"
      ]
    },
    {
      "id": "redis-scan",
      "cmd": "SCAN",
      "cat": "redis",
      "desc": "游标式遍历键",
      "syntax": "SCAN <cursor> [MATCH <pattern>] [COUNT N]",
      "args": [],
      "examples": [
        {
          "cmd": "SCAN 0",
          "comment": "开始遍历(返回新游标)"
        },
        {
          "cmd": "SCAN 0 MATCH user:* COUNT 100",
          "comment": "匹配前缀遍历"
        },
        {
          "cmd": "redis-cli --scan --pattern 'session:*'",
          "comment": "CLI 自动迭代"
        },
        {
          "cmd": "redis-cli --scan --pattern 'user:*' | xargs redis-cli del",
          "comment": "批量删除匹配键"
        }
      ],
      "tags": [
        "redis",
        "遍历"
      ]
    },
    {
      "id": "redis-type",
      "cmd": "TYPE",
      "cat": "redis",
      "desc": "查看键类型",
      "syntax": "TYPE <key>",
      "args": [],
      "examples": [
        {
          "cmd": "TYPE user:1",
          "comment": "返回 string/hash/list..."
        },
        {
          "cmd": "TYPE session:9f3",
          "comment": "确认类型后操作"
        },
        {
          "cmd": "TYPE cache:list",
          "comment": "判断列表类型"
        }
      ],
      "tags": [
        "redis",
        "类型"
      ]
    },
