        },
        {
          "cmd": "LRANGE queue:task 0 9",
          "comment": "取前 10 个"
        },
        {
          "cmd": "LRANGE logs:app -5 -1",
          "comment": "取最后 5 条日志"
        },
        {
          "cmd": "LLEN queue:task",
          "comment": "队列长度"
        }
      ],
      "tags": [
        "redis",
        "列表"
      ]
    },
