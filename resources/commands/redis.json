        },
        {
          "cmd": "RPOP queue:task",
          "comment": "尾部弹出(FIFO 队列)"
        },
        {
          "cmd": "BLPOP queue:task 5",
          "comment": "阻塞等待 5 秒弹出"
        },
        {
          "cmd": "LPOP queue:task 3",
          "comment": "一次弹出 3 个"
        }
      ],
      "tags": [
        "redis",
        "列表"
      ]
    },
    {
      "id": "redis-llen",
