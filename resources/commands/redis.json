[
  { "id": "redis-server", "cmd": "redis-server", "cat": "redis", "desc": "启动 Redis 服务",
    "syntax": "redis-server [redis.conf] [--port 6379] [--daemonize yes]",
    "args": [ { "name": "--daemonize yes", "desc": "后台运行" }, { "name": "--port", "desc": "指定端口" } ],
    "examples": [ { "cmd": "redis-server /usr/local/etc/redis.conf --daemonize yes", "comment": "按配置后台启动" } ],
    "tags": ["redis", "服务"] },
  { "id": "redis-cli", "cmd": "redis-cli", "cat": "redis", "desc": "连接 Redis 客户端",
    "syntax": "redis-cli [-h <host>] [-p <port>] [-a <password>]",
    "args": [ { "name": "-h", "desc": "主机" }, { "name": "-p", "desc": "端口" }, { "name": "-a", "desc": "密码" } ],
    "examples": [ { "cmd": "redis-cli -p 6379 ping", "comment": "连接并检查 PONG" } ],
    "tags": ["redis", "客户端"] },
  { "id": "redis-set", "cmd": "SET", "cat": "redis", "desc": "设置字符串键值",
    "syntax": "SET <key> <value> [EX <sec>] [NX]",
    "args": [ { "name": "EX", "desc": "过期秒数" }, { "name": "NX", "desc": "不存在才设置" } ],
    "examples": [ { "cmd": "SET session:1 abc123 EX 3600", "comment": "设置 1 小时过期" } ],
    "tags": ["redis", "string"] },
  { "id": "redis-get", "cmd": "GET", "cat": "redis", "desc": "获取字符串值",
    "syntax": "GET <key>",
    "args": [],
    "examples": [ { "cmd": "GET session:1", "comment": "取会话值" } ],
    "tags": ["redis", "string"] },
  { "id": "redis-del", "cmd": "DEL", "cat": "redis", "desc": "删除键",
    "syntax": "DEL <key> [key...]",
    "args": [],
    "examples": [ { "cmd": "DEL cache:page1 cache:page2", "comment": "批量删缓存" } ],
    "tags": ["redis", "通用"] },
  { "id": "redis-exists", "cmd": "EXISTS", "cat": "redis", "desc": "判断键是否存在",
    "syntax": "EXISTS <key>",
    "args": [],
    "examples": [ { "cmd": "EXISTS lock:order", "comment": "检查锁是否存在" } ],
    "tags": ["redis", "通用"] },
  { "id": "redis-expire", "cmd": "EXPIRE", "cat": "redis", "desc": "设置键过期时间",
    "syntax": "EXPIRE <key> <seconds>",
    "args": [],
    "examples": [ { "cmd": "EXPIRE cart:100 86400", "comment": "购物车 1 天后过期" } ],
    "tags": ["redis", "过期"] },
  { "id": "redis-ttl", "cmd": "TTL", "cat": "redis", "desc": "查看剩余生存时间",
    "syntax": "TTL <key>",
    "args": [],
    "examples": [ { "cmd": "TTL session:1", "comment": "-1 永不过期, -2 不存在" } ],
    "tags": ["redis", "过期"] },
  { "id": "redis-persist", "cmd": "PERSIST", "cat": "redis", "desc": "移除过期时间",
    "syntax": "PERSIST <key>",
    "args": [],
    "examples": [ { "cmd": "PERSIST session:1", "comment": "取消过期变永久" } ],
    "tags": ["redis", "过期"] },
  { "id": "redis-incr", "cmd": "INCR", "cat": "redis", "desc": "自增计数",
    "syntax": "INCR <key>",
    "args": [],
    "examples": [ { "cmd": "INCR page:views", "comment": "原子自增页面访问量" } ],
    "tags": ["redis", "string"] },
  { "id": "redis-decr", "cmd": "DECR", "cat": "redis", "desc": "自减计数",
    "syntax": "DECR <key>",
    "args": [],
    "examples": [ { "cmd": "DECR stock:item1", "comment": "扣减库存" } ],
    "tags": ["redis", "string"] },
  { "id": "redis-setnx", "cmd": "SETNX", "cat": "redis", "desc": "不存在时设置(分布式锁)",
    "syntax": "SETNX <key> <value>",
    "args": [],
    "examples": [ { "cmd": "SETNX lock:order 1", "comment": "返回 1 表示拿到锁" } ],
    "tags": ["redis", "锁"] },
  { "id": "redis-keys", "cmd": "KEYS", "cat": "redis", "desc": "按模式匹配键(慎用)",
    "syntax": "KEYS <pattern>",
    "args": [],
    "examples": [ { "cmd": "KEYS user:*", "comment": "匹配所有 user 前缀键(生产慎用)" } ],
    "tags": ["redis", "通用"] },
  { "id": "redis-scan", "cmd": "SCAN", "cat": "redis", "desc": "游标式遍历键",
    "syntax": "SCAN <cursor> [MATCH <pattern>] [COUNT N]",
    "args": [ { "name": "MATCH", "desc": "模式过滤" } ],
    "examples": [ { "cmd": "SCAN 0 MATCH user:* COUNT 100", "comment": "分批遍历不阻塞" } ],
    "tags": ["redis", "通用"] },
  { "id": "redis-type", "cmd": "TYPE", "cat": "redis", "desc": "查看键类型",
    "syntax": "TYPE <key>",
    "args": [],
    "examples": [ { "cmd": "TYPE user:1", "comment": "返回 string/hash/list 等" } ],
    "tags": ["redis", "通用"] },
  { "id": "redis-hset", "cmd": "HSET", "cat": "redis", "desc": "设置哈希字段",
    "syntax": "HSET <key> <field> <value>",
    "args": [],
    "examples": [ { "cmd": "HSET user:1 name alice age 30", "comment": "存对象字段" } ],
    "tags": ["redis", "hash"] },
  { "id": "redis-hget", "cmd": "HGET", "cat": "redis", "desc": "获取哈希字段",
    "syntax": "HGET <key> <field>",
    "args": [],
    "examples": [ { "cmd": "HGET user:1 name", "comment": "取单个字段" } ],
    "tags": ["redis", "hash"] },
  { "id": "redis-hgetall", "cmd": "HGETALL", "cat": "redis", "desc": "获取全部哈希字段",
    "syntax": "HGETALL <key>",
    "args": [],
    "examples": [ { "cmd": "HGETALL user:1", "comment": "取整个对象" } ],
    "tags": ["redis", "hash"] },
  { "id": "redis-lpush", "cmd": "LPUSH", "cat": "redis", "desc": "头部压入列表",
    "syntax": "LPUSH <key> <value> [value...]",
    "args": [],
    "examples": [ { "cmd": "LPUSH queue:task task-1", "comment": "任务入队(头)" } ],
    "tags": ["redis", "list"] },
  { "id": "redis-lrange", "cmd": "LRANGE", "cat": "redis", "desc": "取列表区间",
    "syntax": "LRANGE <key> <start> <stop>",
    "args": [],
    "examples": [ { "cmd": "LRANGE queue:task 0 -1", "comment": "取全部元素" } ],
    "tags": ["redis", "list"] },
  { "id": "redis-sadd", "cmd": "SADD", "cat": "redis", "desc": "集合添加元素",
    "syntax": "SADD <key> <member> [member...]",
    "args": [],
    "examples": [ { "cmd": "SADD online:users u1 u2", "comment": "在线用户集合" } ],
    "tags": ["redis", "set"] },
  { "id": "redis-smembers", "cmd": "SMEMBERS", "cat": "redis", "desc": "取集合全部元素",
    "syntax": "SMEMBERS <key>",
    "args": [],
    "examples": [ { "cmd": "SMEMBERS online:users", "comment": "列出所有在线用户" } ],
    "tags": ["redis", "set"] },
  { "id": "redis-zadd", "cmd": "ZADD", "cat": "redis", "desc": "有序集合添加(带分数)",
    "syntax": "ZADD <key> <score> <member> [score member...]",
    "args": [],
    "examples": [ { "cmd": "ZADD leaderboard 100 alice 90 bob", "comment": "排行榜存分数" } ],
    "tags": ["redis", "zset"] },
  { "id": "redis-zrange", "cmd": "ZRANGE", "cat": "redis", "desc": "取有序集合区间",
    "syntax": "ZRANGE <key> <start> <stop> [WITHSCORES]",
    "args": [],
    "examples": [ { "cmd": "ZRANGE leaderboard 0 9 WITHSCORES", "comment": "Top10 排行榜" } ],
    "tags": ["redis", "zset"] },
  { "id": "redis-info", "cmd": "INFO", "cat": "redis", "desc": "查看服务信息",
    "syntax": "INFO [section]",
    "args": [ { "name": "memory", "desc": "内存信息" }, { "name": "clients", "desc": "连接信息" } ],
    "examples": [ { "cmd": "redis-cli INFO memory", "comment": "查看内存使用" } ],
    "tags": ["redis", "监控"] },
  { "id": "redis-monitor", "cmd": "MONITOR", "cat": "redis", "desc": "实时监听所有命令",
    "syntax": "MONITOR",
    "args": [],
    "examples": [ { "cmd": "redis-cli MONITOR", "comment": "调试时观察命令流" } ],
    "tags": ["redis", "调试"] },
  { "id": "redis-select", "cmd": "SELECT", "cat": "redis", "desc": "切换数据库",
    "syntax": "SELECT <index>",
    "args": [],
    "examples": [ { "cmd": "redis-cli -n 1", "comment": "连接时直接选 1 号库" } ],
    "tags": ["redis", "通用"] },
  { "id": "redis-flushdb", "cmd": "FLUSHDB", "cat": "redis", "desc": "清空当前库",
    "syntax": "FLUSHDB",
    "args": [],
    "examples": [ { "cmd": "redis-cli -n 2 FLUSHDB", "comment": "清空 2 号库(慎用)" } ],
    "tags": ["redis", "清理"] },
  { "id": "redis-save", "cmd": "SAVE/BGSAVE", "cat": "redis", "desc": "持久化快照",
    "syntax": "SAVE | BGSAVE",
    "args": [],
    "examples": [ { "cmd": "redis-cli BGSAVE", "comment": "后台落盘不阻塞" } ],
    "tags": ["redis", "持久化"] },
  { "id": "redis-subscribe", "cmd": "SUBSCRIBE/PUBLISH", "cat": "redis", "desc": "发布订阅消息",
    "syntax": "PUBLISH <channel> <msg> | SUBSCRIBE <channel>",
    "args": [],
    "examples": [ { "cmd": "redis-cli PUBLISH news 'hello'", "comment": "向 news 频道发消息" } ],
    "tags": ["redis", "消息"] },
  { "id": "redis-config-get", "cmd": "CONFIG GET", "cat": "redis", "desc": "查看运行配置",
    "syntax": "CONFIG GET <pattern>",
    "args": [],
    "examples": [ { "cmd": "redis-cli CONFIG GET maxmemory", "comment": "查看最大内存限制" } ],
    "tags": ["redis", "配置"] },
  { "id": "redis-lpop", "cmd": "LPOP/RPOP", "cat": "redis", "desc": "从列表弹出元素",
    "syntax": "LPOP <key> | RPOP <key>", "args": [],
    "examples": [ { "cmd": "RPOP queue:task", "comment": "消费者取任务(FIFO)" } ],
    "tags": ["redis", "list"] },
  { "id": "redis-llen", "cmd": "LLEN", "cat": "redis", "desc": "查看列表长度",
    "syntax": "LLEN <key>", "args": [],
    "examples": [ { "cmd": "LLEN queue:task", "comment": "查看积压任务数" } ],
    "tags": ["redis", "list"] }
]
