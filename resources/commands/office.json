    "examples": [ { "cmd": "git push -u origin main", "comment": "首次推送并设上游" } ],
    "tags": ["git", "远程"] },
  { "id": "git-pull", "cmd": "git pull", "cat": "office", "desc": "拉取并合并远程变更",
