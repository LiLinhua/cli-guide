    {
      "id": "kubectl-wait",
      "cmd": "kubectl wait",
      "cat": "k8s",
      "desc": "等待资源满足条件",
      "syntax": "kubectl wait --for=condition=<cond> <res>/<name>",
      "args": [
        {
          "name": "--for=condition=Ready",
          "desc": "等待就绪"
        },
        {
          "name": "--timeout",
          "desc": "超时时间"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl wait --for=condition=Ready pod/nginx-7c8b9 --timeout=60s",
          "comment": "等 Pod 就绪"
        },
        {
          "cmd": "kubectl wait --for=condition=Available deploy/web --timeout=120s",
          "comment": "等部署可用"
        },
        {
          "cmd": "kubectl wait --for=delete pod/tmp-pod",
          "comment": "等待 Pod 被删除"
        },
        {
          "cmd": "kubectl apply -f deploy.yaml && kubectl wait --for=condition=Available deploy/web",
          "comment": "部署后等待就绪"
        },
        {
          "cmd": "kubectl rollout status deploy/web --timeout=5m",
          "comment": "等待发布完成"
        }
      ],
      "tags": [
        "等待",
        "就绪"
      ]
    },
