{
  "cat": "k8s",
  "label": "k8s 命令",
  "order": 2,
  "commands": [
    {
      "id": "kubectl-get",
      "cmd": "kubectl get",
      "cat": "k8s",
      "desc": "查询资源列表",
      "syntax": "kubectl get <resource> [-n <ns>] [-A] [-o <fmt>]",
      "args": [
        {
          "name": "-A",
          "desc": "全部命名空间"
        },
        {
          "name": "-n",
          "desc": "指定命名空间"
        },
        {
          "name": "-o wide/yaml/json",
          "desc": "输出格式"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl get pods",
          "comment": "查看当前命名空间 Pod"
        },
        {
          "cmd": "kubectl get pods -A",
          "comment": "查看全部命名空间 Pod"
        },
        {
          "cmd": "kubectl get pods -n kube-system",
          "comment": "指定命名空间查看"
        },
        {
          "cmd": "kubectl get pods -o wide",
          "comment": "查看节点与 IP 详情"
        },
        {
          "cmd": "kubectl get deploy -o yaml",
          "comment": "以 YAML 格式输出"
        },
        {
          "cmd": "kubectl get pods -l app=nginx",
          "comment": "按标签过滤"
        },
        {
          "cmd": "kubectl get pods --field-selector=status.phase=Running",
          "comment": "按字段过滤运行中"
        }
      ],
      "tags": [
        "查询",
        "资源"
      ]
    },
    {
      "id": "kubectl-describe",
      "cmd": "kubectl describe",
      "cat": "k8s",
      "desc": "查看资源详细信息与事件",
      "syntax": "kubectl describe <resource> <name> [-n <ns>]",
      "args": [
        {
          "name": "-n",
          "desc": "指定命名空间"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl describe pod nginx-7c8b9",
          "comment": "查看 Pod 详情与事件"
        },
        {
          "cmd": "kubectl describe node worker-1",
          "comment": "查看节点资源与状态"
        },
        {
          "cmd": "kubectl describe deploy web -n prod",
          "comment": "查看指定命名空间部署"
        },
        {
          "cmd": "kubectl describe svc nginx",
          "comment": "查看服务详情"
        },
        {
          "cmd": "kubectl get events --sort-by=.lastTimestamp | tail",
          "comment": "排障先看最近事件"
        }
      ],
      "tags": [
        "排查",
        "详情"
      ]
    },
    {
      "id": "kubectl-logs",
      "cmd": "kubectl logs",
      "cat": "k8s",
      "desc": "查看容器日志",
      "syntax": "kubectl logs <pod> [-f] [-c <container>]",
      "args": [
        {
          "name": "-f",
          "desc": "持续跟随"
        },
        {
          "name": "-c",
          "desc": "指定容器"
        },
        {
          "name": "--previous",
          "desc": "上次实例日志"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl logs nginx-7c8b9",
          "comment": "查看 Pod 日志"
        },
        {
          "cmd": "kubectl logs -f nginx-7c8b9",
          "comment": "实时跟踪日志"
        },
        {
          "cmd": "kubectl logs pod-app -c sidecar",
          "comment": "查看指定容器日志"
        },
        {
          "cmd": "kubectl logs --previous crashed-pod",
          "comment": "查看崩溃前日志"
        },
        {
          "cmd": "kubectl logs -f deploy/web",
          "comment": "按部署名跟踪日志"
        },
        {
          "cmd": "kubectl logs pod-x --tail=100",
          "comment": "只看末尾 100 行"
        }
      ],
      "tags": [
        "日志",
        "排障"
      ]
    },
    {
      "id": "kubectl-exec",
      "cmd": "kubectl exec",
      "cat": "k8s",
      "desc": "进入容器执行命令",
      "syntax": "kubectl exec -it <pod> -- <cmd>",
      "args": [
        {
          "name": "-it",
          "desc": "交互式终端"
        },
        {
          "name": "--",
          "desc": "分隔 kubectl 与容器命令"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl exec -it nginx-7c8b9 -- /bin/sh",
          "comment": "进入容器 shell"
        },
        {
          "cmd": "kubectl exec nginx-7c8b9 -- ls /etc/nginx",
          "comment": "容器内执行单条命令"
        },
        {
          "cmd": "kubectl exec -it db-pod -c mysql -- mysql -uroot -p",
          "comment": "进入多容器 Pod 的指定容器"
        },
        {
          "cmd": "kubectl exec pod-x -- cat /etc/hosts",
          "comment": "查看容器内文件"
        },
        {
          "cmd": "kubectl exec pod-x -- env",
          "comment": "查看容器环境变量"
        }
      ],
      "tags": [
        "调试",
        "容器"
      ]
    },
    {
      "id": "kubectl-apply",
      "cmd": "kubectl apply",
      "cat": "k8s",
      "desc": "声明式创建/更新资源",
      "syntax": "kubectl apply -f <file|dir>",
      "args": [
        {
          "name": "-f",
          "desc": "清单文件或目录"
        },
        {
          "name": "-k",
          "desc": "kustomize 目录"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl apply -f deploy.yaml",
          "comment": "应用单个清单"
        },
        {
          "cmd": "kubectl apply -f manifests/",
          "comment": "应用整个目录"
        },
        {
          "cmd": "kubectl apply -k overlays/prod",
          "comment": "应用 kustomize 渲染结果"
        },
        {
          "cmd": "kubectl apply -f https://example.com/deploy.yaml",
          "comment": "从 URL 应用"
        },
        {
          "cmd": "kubectl apply -f deploy.yaml -n prod",
          "comment": "应用到指定命名空间"
        },
        {
          "cmd": "kubectl apply --dry-run=client -f deploy.yaml",
          "comment": "客户端试运行不实际应用"
        }
      ],
      "tags": [
        "部署",
        "声明式"
      ]
    },
    {
      "id": "kubectl-create",
      "cmd": "kubectl create",
      "cat": "k8s",
      "desc": "命令式创建资源",
      "syntax": "kubectl create deployment <name> --image=<img>",
      "args": [
        {
          "name": "--image",
          "desc": "镜像"
        },
        {
          "name": "--replicas",
          "desc": "副本数"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl create deployment nginx --image=nginx",
          "comment": "创建部署"
        },
        {
          "cmd": "kubectl create deployment web --image=nginx:1.25 --replicas=3",
          "comment": "指定副本数创建"
        },
        {
          "cmd": "kubectl create deployment api --image=myapp:v1 --port=8080",
          "comment": "创建并暴露端口"
        },
        {
          "cmd": "kubectl create ns staging",
          "comment": "创建命名空间"
        },
        {
          "cmd": "kubectl create secret generic db-pass --from-literal=password=123",
          "comment": "创建密钥"
        },
        {
          "cmd": "kubectl create configmap app-config --from-file=config.yaml",
          "comment": "从文件创建配置"
        }
      ],
      "tags": [
        "创建",
        "部署"
      ]
    },
    {
      "id": "kubectl-delete",
      "cmd": "kubectl delete",
      "cat": "k8s",
      "desc": "删除资源",
      "syntax": "kubectl delete <resource> <name> [-f file]",
      "args": [
        {
          "name": "-f",
          "desc": "按清单删除"
        },
        {
          "name": "--grace-period=0 --force",
          "desc": "强制立即删除"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl delete pod nginx-7c8b9",
          "comment": "删除单个 Pod"
        },
        {
          "cmd": "kubectl delete deploy web svc web",
          "comment": "一次删除多个资源"
        },
        {
          "cmd": "kubectl delete -f deploy.yaml",
          "comment": "按清单删除"
        },
        {
          "cmd": "kubectl delete pod --all -n dev",
          "comment": "清空命名空间全部 Pod"
        },
        {
          "cmd": "kubectl delete pod stuck-pod --grace-period=0 --force",
          "comment": "强制删除卡住的 Pod"
        },
        {
          "cmd": "kubectl delete ns staging",
          "comment": "删除整个命名空间"
        }
      ],
      "tags": [
        "删除"
      ]
    },
    {
      "id": "kubectl-get-nodes",
      "cmd": "kubectl get nodes",
      "cat": "k8s",
      "desc": "查看集群节点状态",
      "syntax": "kubectl get nodes",
      "args": [
        {
          "name": "-o wide",
          "desc": "详细信息"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl get nodes",
          "comment": "查看节点状态"
        },
        {
          "cmd": "kubectl get nodes -o wide",
          "comment": "查看节点 IP 与角色"
        },
        {
          "cmd": "kubectl get nodes -l node-role.kubernetes.io/control-plane",
          "comment": "只看控制面节点"
        },
        {
          "cmd": "kubectl describe node worker-1 | head -30",
          "comment": "查看节点资源详情"
        },
        {
          "cmd": "kubectl top node",
          "comment": "查看节点资源占用"
        }
      ],
      "tags": [
        "节点",
        "集群"
      ]
    },
    {
      "id": "kubectl-cluster-info",
      "cmd": "kubectl cluster-info",
      "cat": "k8s",
      "desc": "查看集群信息",
      "syntax": "kubectl cluster-info",
      "args": [],
      "examples": [
        {
          "cmd": "kubectl cluster-info",
          "comment": "查看集群端点信息"
        },
        {
          "cmd": "kubectl cluster-info dump | less",
          "comment": "导出集群全量信息"
        },
        {
          "cmd": "kubectl config current-context",
          "comment": "查看当前上下文"
        },
        {
          "cmd": "kubectl get endpoints kubernetes",
          "comment": "查看 API 端点"
        }
      ],
      "tags": [
        "集群",
        "信息"
      ]
    },
    {
      "id": "kubectl-scale",
      "cmd": "kubectl scale",
      "cat": "k8s",
      "desc": "扩缩容副本",
      "syntax": "kubectl scale deploy <name> --replicas=<n>",
      "args": [
        {
          "name": "--replicas",
          "desc": "目标副本数"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl scale deploy web --replicas=5",
          "comment": "扩容到 5 副本"
        },
        {
          "cmd": "kubectl scale deploy web --replicas=0",
          "comment": "缩容到 0 暂停服务"
        },
        {
          "cmd": "kubectl scale sts db --replicas=1",
          "comment": "缩状态集副本"
        },
        {
          "cmd": "kubectl scale deploy web --replicas=3 -n prod",
          "comment": "指定命名空间扩容"
        },
        {
          "cmd": "kubectl rollout status deploy/web",
          "comment": "确认扩容完成"
        }
      ],
      "tags": [
        "伸缩",
        "副本"
      ]
    },
    {
      "id": "kubectl-rollout",
      "cmd": "kubectl rollout",
      "cat": "k8s",
      "desc": "管理发布",
      "syntax": "kubectl rollout <status|restart|undo> deploy <name>",
      "args": [
        {
          "name": "status",
          "desc": "发布进度"
        },
        {
          "name": "restart",
          "desc": "重启滚动"
        },
        {
          "name": "undo",
          "desc": "回滚上一版"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl rollout status deploy/web",
          "comment": "查看发布进度"
        },
        {
          "cmd": "kubectl rollout restart deploy/web",
          "comment": "滚动重启 Pod"
        },
        {
          "cmd": "kubectl rollout undo deploy/web",
          "comment": "回滚到上一版本"
        },
        {
          "cmd": "kubectl rollout undo deploy/web --to-revision=3",
          "comment": "回滚到指定版本"
        },
        {
          "cmd": "kubectl rollout history deploy/web",
          "comment": "查看发布历史"
        },
        {
          "cmd": "kubectl rollout pause deploy/web",
          "comment": "暂停发布"
        }
      ],
      "tags": [
        "发布",
        "回滚"
      ]
    },
    {
      "id": "kubectl-port-forward",
      "cmd": "kubectl port-forward",
      "cat": "k8s",
      "desc": "端口转发到本地",
      "syntax": "kubectl port-forward <pod> <local>:<remote>",
      "args": [],
      "examples": [
        {
          "cmd": "kubectl port-forward pod/redis-0 6379:6379",
          "comment": "本地访问容器 Redis"
        },
        {
          "cmd": "kubectl port-forward svc/mysql 3306:3306",
          "comment": "按服务转发"
        },
        {
          "cmd": "kubectl port-forward deploy/web 8080:80",
          "comment": "按部署转发"
        },
        {
          "cmd": "kubectl port-forward pod/db-0 15432:5432 -n prod",
          "comment": "指定命名空间转发"
        },
        {
          "cmd": "kubectl port-forward pod/web 8080:80 &",
          "comment": "后台转发"
        }
      ],
      "tags": [
        "调试",
        "网络"
      ]
    },
    {
      "id": "kubectl-explain",
      "cmd": "kubectl explain",
      "cat": "k8s",
      "desc": "查看资源字段说明",
      "syntax": "kubectl explain <resource>[.field]",
      "args": [],
      "examples": [
        {
          "cmd": "kubectl explain pod",
          "comment": "查看 Pod 字段说明"
        },
        {
          "cmd": "kubectl explain pod.spec.containers",
          "comment": "逐级查看字段"
        },
        {
          "cmd": "kubectl explain deploy.spec.strategy.rollingUpdate",
          "comment": "查看滚动更新配置字段"
        },
        {
          "cmd": "kubectl explain svc.spec.type",
          "comment": "查看服务类型字段"
        },
        {
          "cmd": "kubectl explain --recursive pod | less",
          "comment": "递归查看全部字段"
        }
      ],
      "tags": [
        "文档",
        "字段"
      ]
    },
    {
      "id": "kubectl-top",
      "cmd": "kubectl top",
      "cat": "k8s",
      "desc": "查看资源占用",
      "syntax": "kubectl top <pod|node> [-A]",
      "args": [
        {
          "name": "-A",
          "desc": "全部命名空间"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl top node",
          "comment": "节点资源占用排行"
        },
        {
          "cmd": "kubectl top pod -A",
          "comment": "全部命名空间 Pod 占用"
        },
        {
          "cmd": "kubectl top pod -n prod",
          "comment": "指定命名空间查看"
        },
        {
          "cmd": "kubectl top pod --sort-by=cpu -A | head",
          "comment": "按 CPU 排序"
        },
        {
          "cmd": "kubectl top pod --containers -A",
          "comment": "按容器粒度查看"
        }
      ],
      "tags": [
        "监控",
        "资源"
      ]
    },
    {
      "id": "kubectl-edit",
      "cmd": "kubectl edit",
      "cat": "k8s",
      "desc": "编辑线上资源",
      "syntax": "kubectl edit <resource> <name>",
      "args": [],
      "examples": [
        {
          "cmd": "kubectl edit deploy/web",
          "comment": "编辑部署配置"
        },
        {
          "cmd": "kubectl edit cm app-config",
          "comment": "编辑配置映射"
        },
        {
          "cmd": "kubectl edit svc nginx",
          "comment": "编辑服务配置"
        },
        {
          "cmd": "kubectl edit deploy/web -n prod",
          "comment": "编辑指定命名空间资源"
        },
        {
          "cmd": "kubectl edit --validate=false deploy/web",
          "comment": "跳过校验编辑"
        }
      ],
      "tags": [
        "编辑",
        "修改"
      ]
    },
    {
      "id": "kubectl-get-ns",
      "cmd": "kubectl get ns",
      "cat": "k8s",
      "desc": "查看命名空间列表",
      "syntax": "kubectl get ns",
      "args": [],
      "examples": [
        {
          "cmd": "kubectl get ns",
          "comment": "查看全部命名空间"
        },
        {
          "cmd": "kubectl get ns -o jsonpath='{.items[*].metadata.name}'",
          "comment": "只取命名空间名"
        },
        {
          "cmd": "kubectl get ns | grep active",
          "comment": "过滤活跃命名空间"
        },
        {
          "cmd": "kubectl get pods -n default",
          "comment": "默认命名空间操作"
        }
      ],
      "tags": [
        "命名空间"
      ]
    },
    {
      "id": "kubectl-create-ns",
      "cmd": "kubectl create ns",
      "cat": "k8s",
      "desc": "创建命名空间",
      "syntax": "kubectl create ns <name>",
      "args": [],
      "examples": [
        {
          "cmd": "kubectl create ns dev",
          "comment": "创建 dev 命名空间"
        },
        {
          "cmd": "kubectl create ns staging",
          "comment": "创建 staging 命名空间"
        },
        {
          "cmd": "kubectl label ns dev team=backend",
          "comment": "给命名空间打标签"
        },
        {
          "cmd": "kubectl get ns dev -o yaml",
          "comment": "确认命名空间已创建"
        }
      ],
      "tags": [
        "命名空间",
        "创建"
      ]
    },
    {
      "id": "kubectl-get-svc",
      "cmd": "kubectl get svc",
      "cat": "k8s",
      "desc": "查看服务列表",
      "syntax": "kubectl get svc [-n <ns>]",
      "args": [
        {
          "name": "-n",
          "desc": "指定命名空间"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl get svc",
          "comment": "查看服务列表"
        },
        {
          "cmd": "kubectl get svc -n prod",
          "comment": "查看指定命名空间服务"
        },
        {
          "cmd": "kubectl get svc -o wide",
          "comment": "查看 ClusterIP 详情"
        },
        {
          "cmd": "kubectl get svc nginx -o yaml",
          "comment": "导出服务 YAML"
        },
        {
          "cmd": "kubectl get endpoints svc nginx",
          "comment": "查看服务后端端点"
        }
      ],
      "tags": [
        "服务",
        "网络"
      ]
    },
    {
      "id": "kubectl-get-cm",
      "cmd": "kubectl get cm",
      "cat": "k8s",
      "desc": "查看配置映射",
      "syntax": "kubectl get cm [-n <ns>]",
      "args": [
        {
          "name": "-n",
          "desc": "指定命名空间"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl get cm",
          "comment": "查看配置映射列表"
        },
        {
          "cmd": "kubectl get cm app-config -o yaml",
          "comment": "查看配置内容"
        },
        {
          "cmd": "kubectl create cm env-config --from-literal=ENV=prod",
          "comment": "命令行创建配置"
        },
        {
          "cmd": "kubectl create cm app-conf --from-file=app.properties",
          "comment": "从文件创建配置"
        },
        {
          "cmd": "kubectl get cm -n kube-system | head",
          "comment": "查看系统命名空间配置"
        }
      ],
      "tags": [
        "配置"
      ]
    },
    {
      "id": "kubectl-get-secret",
      "cmd": "kubectl get secret",
      "cat": "k8s",
      "desc": "查看密钥",
      "syntax": "kubectl get secret [-n <ns>]",
      "args": [
        {
          "name": "-n",
          "desc": "指定命名空间"
        }
      ],
      "examples": [
        {
          "cmd": "kubectl get secret",
          "comment": "查看密钥列表"
        },
        {
          "cmd": "kubectl get secret db-pass -o yaml",
          "comment": "查看密钥内容"
        },
        {
          "cmd": "kubectl get secret db-pass -o jsonpath='{.data.password}' | base64 -d",
          "comment": "解密查看密码"
        },
        {
          "cmd": "kubectl create secret tls tls-cert --cert=cert.pem --key=key.pem",
          "comment": "创建 TLS 密钥"
        },
